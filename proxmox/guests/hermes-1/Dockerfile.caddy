FROM caddy:2.11.9-builder-alpine@sha256:646fee578e680989ca5c7fd1ce6f1de574d19fd71ef2221810cc0510a9f40c86 AS builder

# renovate: datasource=go depName=github.com/caddy-dns/cloudflare
ARG CLOUDFLARE_VERSION=v0.2.4
ENV GOTOOLCHAIN=local

RUN xcaddy build "${CADDY_VERSION}" \
      --with "github.com/caddy-dns/cloudflare@${CLOUDFLARE_VERSION}"

FROM caddy:2.11.9-alpine@sha256:003a97808e781aa9f7e75cc2f43d34d461099031faf5e20faefb9f61126836f0

RUN addgroup -S -g 1000 caddy \
    && adduser -S -D -H -u 1000 -G caddy caddy

COPY --from=builder /usr/bin/caddy /usr/bin/caddy

USER 1000:1000
