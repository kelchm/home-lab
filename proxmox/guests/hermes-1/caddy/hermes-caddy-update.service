[Unit]
Description=Reconcile the reviewed Hermes Caddy image only
Wants=network-online.target
After=network-online.target docker.service
Requires=docker.service

[Service]
Type=oneshot
User=root
UMask=0077
ExecStart=/usr/local/sbin/hermes-caddy-update run
TimeoutStartSec=15min
KillMode=control-group
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/hermes-caddy /opt/hermes
NoNewPrivileges=true
