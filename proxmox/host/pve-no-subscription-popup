#!/bin/sh
set -eu

target=${1:-/usr/share/javascript/proxmox-widget-toolkit/proxmoxlib.js}
marker='Local no-subscription policy: skip the modal while preserving repository status reporting.'
backup_dir=/var/lib/pve-no-subscription-popup

test -f "$target"

if grep -Fq "$marker" "$target"; then
    exit 0
fi

mkdir -p "$backup_dir"
digest=$(sha256sum "$target" | awk '{print $1}')
backup="$backup_dir/proxmoxlib.js.$digest"
test -e "$backup" || install -m 0644 "$target" "$backup"

tmp=$(mktemp "${target}.tmp.XXXXXX")
trap 'rm -f "$tmp"' EXIT INT TERM

perl -0777 -e '
    local $/;
    my $source = <>;
    my $count = ($source =~ s{^        checked_command: function \(orig_cmd\) \{\n.*?^        \},\n(?=\n^        assemble_field_data:)}{        checked_command: function (orig_cmd) {\n            // Local no-subscription policy: skip the modal while preserving repository status reporting.\n            orig_cmd();\n        },\n}gms);
    die "expected exactly one upstream checked_command block, found $count\n" unless $count == 1;
    print $source;
' "$target" >"$tmp"

grep -Fq "$marker" "$tmp"
install -o root -g root -m 0644 "$tmp" "$target"
