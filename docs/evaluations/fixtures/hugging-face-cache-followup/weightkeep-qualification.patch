+	"github.com/afshinghezeli/weightkeep/internal/store"
+	"github.com/afshinghezeli/weightkeep/internal/testutil/fakehub"
+)
+
+func evalLocal(t *testing.T, root, path string, body []byte) {
+	t.Helper()
+	full := filepath.Join(root, filepath.FromSlash(path))
+	if err := os.MkdirAll(filepath.Dir(full), 0755); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(full, body, 0644); err != nil {
+		t.Fatal(err)
+	}
+}
+
+func TestNASEvalImportNativeAndRenamedPlain(t *testing.T) {
+	k, h := newKeeper(t)
+	ctx := context.Background()
+	root := t.TempDir()
+	snapshot := filepath.Join(root, "snapshots", "commit")
+	for _, f := range []fakehub.File{cfg, lic, q4} {
+		blob := filepath.Join(root, "blobs", f.ETag())
+		evalLocal(t, root, "blobs/"+f.ETag(), f.Content)
+		if err := os.MkdirAll(snapshot, 0755); err != nil {
+			t.Fatal(err)
+		}
+		rel, _ := filepath.Rel(snapshot, blob)
+		if err := os.Symlink(rel, filepath.Join(snapshot, f.Path)); err != nil {
+			t.Fatal(err)
+		}
+	}
+	r, err := k.ImportDirectory(ctx, ImportDirectoryRequest{Repo: tinyRep, Directory: snapshot})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(r.Imported) != 3 || len(r.Reused) != 0 || len(r.Missing) != 3 {
+		t.Fatalf("result: %+v", r)
+	}
+	for _, req := range h.Requests() {
+		if req.Host == "cdn" || req.Path != "/api/models/acme/tiny/revision/main" && req.Path != "/api/models/acme/tiny/tree/"+r.Manifest.Commit {
+			t.Errorf("unexpected payload request: %+v", req)
+		}
+	}
+	if k.Store.Has(q8.SHA256()) || k.Store.Has(shard.SHA256()) {
+		t.Fatal("missing weights were downloaded")
+	}
+	if got, err := os.ReadFile(filepath.Join(snapshot, q4.Path)); err != nil || !bytes.Equal(got, q4.Content) {
+		t.Fatal("source changed")
+	}
+	other := hub.Repo{Type: hub.Model, ID: "other/renamed"}
+	renamed := q4
+	renamed.Path = "upstream-name.gguf"
+	h.Add(&fakehub.Repo{ID: other.ID, Files: []fakehub.File{cfg, lic, renamed}})
+	plain := t.TempDir()
+	evalLocal(t, plain, "local-name.gguf", q4.Content)
+	h.ResetRequests()
+	r2, err := k.ImportDirectory(ctx, ImportDirectoryRequest{Repo: other, Directory: plain, SourcePaths: map[string]string{renamed.Path: "local-name.gguf"}})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(r2.Imported) != 0 || len(r2.Reused) != 3 {
+		t.Fatalf("second repo: %+v", r2)
+	}
+	for _, req := range h.Requests() {
+		if req.Host == "cdn" {
+			t.Fatal("import downloaded payload")
+		}
+	}
+	var n int
+	k.Store.DB().QueryRow("SELECT count(*) FROM blobs WHERE sha256=?", q4.SHA256()).Scan(&n)
+	if n != 1 {
+		t.Errorf("weight records=%d", n)
+	}
+	if _, err := manifest.Load(ctx, k.Store, r2.Manifest.Repo, r2.Manifest.Commit); err != nil {
+		t.Fatal(err)
+	}
+	t.Log("native symlink snapshot imported with metadata requests only; absent weights stay absent; second repo and renamed file reuse one stored weight; sources preserved")
+}
+
+func TestNASEvalImportRejectsCorruption(t *testing.T) {
+	k, _ := newKeeper(t)
+	root := t.TempDir()
+	for _, f := range []fakehub.File{cfg, lic, q4} {
+		body := f.Content
+		if f.LFS {
+			body = bytes.Repeat([]byte("X"), len(body))
+		}
+		evalLocal(t, root, f.Path, body)
+	}
+	r, err := k.ImportDirectory(context.Background(), ImportDirectoryRequest{Repo: tinyRep, Directory: root})
+	if !errors.Is(err, store.ErrHashMismatch) {
+		t.Fatalf("err=%v", err)
+	}
+	if k.Store.Has(q4.SHA256()) {
+		t.Fatal("corrupt weights retained")
+	}
+	if _, err := manifest.Load(context.Background(), k.Store, r.Manifest.Repo, r.Manifest.Commit); !errors.Is(err, manifest.ErrNotFound) {
+		t.Errorf("failed import published: %v", err)
+	}
+	t.Log("same-size corruption rejected; revision not published")
+}
