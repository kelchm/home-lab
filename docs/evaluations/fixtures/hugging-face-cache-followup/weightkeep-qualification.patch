+)
+
+func TestNASEvalCrossRepoConcurrentAndSelective(t *testing.T) {
+	h := newHarness(t, Options{VerifyBeforeServe: true})
+	other := weights
+	other.Path = "renamed.gguf"
+	unused := fakehub.File{Path: "unused-quant.gguf", Content: bytes.Repeat([]byte("unused"), 10000), LFS: true}
+	h.up.Add(&fakehub.Repo{ID: "another/copy", Files: []fakehub.File{cfgFile, other, unused}})
+	paths := []string{"/acme/tiny/resolve/main/model.safetensors", "/another/copy/resolve/main/renamed.gguf"}
+	for _, path := range paths {
+		h.do(t, http.MethodHead, path, nil)
+	}
+	h.up.ResetRequests()
+	var wg sync.WaitGroup
+	start := make(chan struct{})
+	for i := 0; i < 12; i++ {
+		wg.Add(1)
+		go func(i int) {
+			defer wg.Done()
+			<-start
+			resp, body := h.do(t, http.MethodGet, paths[i%2], nil)
+			if resp.StatusCode != 200 || !bytes.Equal(body, weights.Content) {
+				t.Errorf("client %d: status=%d length=%d", i, resp.StatusCode, len(body))
+			}
+		}(i)
+	}
+	close(start)
+	wg.Wait()
+	if n := h.cdnRequests(); n != 1 {
+		t.Errorf("CDN payload requests=%d, want 1", n)
+	}
+	if h.st.Has(unused.SHA256()) {
+		t.Error("unrequested quant was fetched")
+	}
+	var n int
+	if err := h.st.DB().QueryRow("SELECT count(*) FROM blobs WHERE sha256=?", weights.SHA256()).Scan(&n); err != nil || n != 1 {
+		t.Errorf("stored records=%d err=%v", n, err)
+	}
+	t.Logf("12 clients, 2 repos, renamed weight: CDN requests=%d; unused quant retained=%v", h.cdnRequests(), h.st.Has(unused.SHA256()))
+}
+
+func TestNASEvalRevisionReuseAndRestartOffline(t *testing.T) {
+	h := newHarness(t, Options{VerifyBeforeServe: true, RefTTL: time.Nanosecond})
+	resp, _ := h.do(t, http.MethodGet, "/acme/tiny/resolve/main/model.safetensors", nil)
+	old := resp.Header.Get("X-Repo-Commit")
+	next := strings.Repeat("b", 40)
+	h.up.Add(&fakehub.Repo{ID: "acme/tiny", Commit: next, Files: []fakehub.File{cfgFile, weights, emptyFile}})
+	h.up.ResetRequests()
+	resp, body := h.do(t, http.MethodGet, "/acme/tiny/resolve/main/model.safetensors", nil)
+	if resp.Header.Get("X-Repo-Commit") != next || !bytes.Equal(body, weights.Content) {
+		t.Fatal("failed to resolve new revision")
+	}
+	if n := h.cdnRequests(); n != 0 {
+		t.Errorf("unchanged revision downloaded payload %d times", n)
+	}
+	root := h.st.Root()
+	h.proxy.Close()
+	h.st.Close()
+	st, err := store.Open(context.Background(), root)
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { st.Close() })
+	h.st = st
+	h.k.Store = st
+	h.k.Fetcher.Store = st
+	h.k.Fetcher.Retries = 1
+	h.up.Fail("/", http.StatusServiceUnavailable, 1000)
+	h.proxy = httptest.NewServer(New(h.k, Options{VerifyBeforeServe: true, RefTTL: time.Nanosecond}))
+	t.Cleanup(h.proxy.Close)
+	for _, rev := range []string{old, next, "main"} {
+		resp, body = h.do(t, http.MethodGet, "/acme/tiny/resolve/"+rev+"/model.safetensors", nil)
+		if resp.StatusCode != 200 || !bytes.Equal(body, weights.Content) {
+			t.Errorf("restart upstream down rev=%s status=%d len=%d", rev, resp.StatusCode, len(body))
+		}
+	}
+	t.Log("unchanged new revision: zero payload GETs; reopened DB/server serves both commit pins and expired main with upstream returning 503")
+}
+
+type nasRoundTrip func(*http.Request) (*http.Response, error)
+
+func (f nasRoundTrip) RoundTrip(r *http.Request) (*http.Response, error) { return f(r) }
+
+type nasGateBody struct {
+	io.ReadCloser
+	read    int
+	release <-chan struct{}
+}
+
+func (b *nasGateBody) Read(p []byte) (int, error) {
+	if b.read >= 4096 {
+		<-b.release
+	}
+	if len(p) > 4096 {
+		p = p[:4096]
+	}
+	n, e := b.ReadCloser.Read(p)
+	b.read += n
+	return n, e
+}
+
+func TestNASEvalCorruptEarlyRange(t *testing.T) {
+	h := newHarness(t, Options{VerifyBeforeServe: true})
+	h.do(t, http.MethodHead, "/acme/tiny/resolve/main/config.json", nil)
+	bad := weights
+	bad.Content = bytes.Repeat([]byte("X"), len(weights.Content))
+	h.up.Add(&fakehub.Repo{ID: "acme/tiny", Files: []fakehub.File{cfgFile, bad, emptyFile}})
+	release := make(chan struct{})
+	var once sync.Once
+	unblock := func() { once.Do(func() { close(release) }) }
+	defer unblock()
+	time.AfterFunc(200*time.Millisecond, unblock)
+	client, err := hub.New(h.up.URL, hub.Options{Transport: nasRoundTrip(func(r *http.Request) (*http.Response, error) {
+		resp, err := http.DefaultTransport.RoundTrip(r)
+		if err == nil && strings.HasPrefix(r.URL.String(), h.up.CDN) {
+			resp.Body = &nasGateBody{ReadCloser: resp.Body, release: release}
+		}
+		return resp, err
+	})})
+	if err != nil {
+		t.Fatal(err)
+	}
+	h.k.Hub = client
+	h.k.Fetcher.Hub = client
+	req, _ := http.NewRequest(http.MethodGet, h.proxy.URL+"/acme/tiny/resolve/main/model.safetensors", nil)
+	req.Header.Set("Range", "bytes=0-99")
+	c := &http.Client{Timeout: 2 * time.Second}
+	resp, err := c.Do(req)
+	if err != nil {
+		unblock()
+		t.Fatalf("range request: %v", err)
+	}
+	body, readErr := io.ReadAll(resp.Body)
+	resp.Body.Close()
+	t.Logf("before complete-file verification: status=%d bytes=%d read_error=%v body_matches_bad=%v", resp.StatusCode, len(body), readErr, bytes.Equal(body, bad.Content[:100]))
+	// Record the unsafe behavior explicitly, then allow the background fetch to
+	// finish so teardown cannot race with an outstanding writer.
+	unsafe := resp.StatusCode == 206 && readErr == nil && bytes.Equal(body, bad.Content[:100])
+	unblock()
+	deadline := time.Now().Add(3 * time.Second)
+	srv := h.proxy.Config.Handler.(*Server)
+	for time.Now().Before(deadline) {
+		srv.flights.mu.Lock()
+		n := len(srv.flights.m)
+		srv.flights.mu.Unlock()
+		if n == 0 {
+			break
+		}
+		time.Sleep(10 * time.Millisecond)
+	}
+	if h.st.Has(weights.SHA256()) || h.st.Has(bad.SHA256()) {
+		t.Error("corrupt blob retained")
+	}
+	if unsafe {
+		t.Error(fmt.Sprintf("integrity gap: complete successful range contains %d corrupt bytes before hash validation", len(body)))
+	}
+}
+
+type nasSlowBody struct{ io.ReadCloser }
+
+func (b *nasSlowBody) Read(p []byte) (int, error) {
+	time.Sleep(3 * time.Millisecond)
+	if len(p) > 65536 {
+		p = p[:65536]
+	}
+	return b.ReadCloser.Read(p)
+}
+
+func TestNASEvalSDKResumeIntegrity(t *testing.T) {
+	h := newHarness(t, Options{VerifyBeforeServe: true})
+	good := fakehub.File{Path: "model.safetensors", Content: bytes.Repeat([]byte("good-weights-1234"), 1572864), LFS: true}
+	h.up.Add(&fakehub.Repo{ID: "acme/tiny", Files: []fakehub.File{cfgFile, good}})
+	var injected atomic.Bool
+	client, err := hub.New(h.up.URL, hub.Options{Transport: nasRoundTrip(func(r *http.Request) (*http.Response, error) {
+		resp, err := http.DefaultTransport.RoundTrip(r)
+		if err == nil && strings.HasPrefix(r.URL.String(), h.up.CDN) && r.Method == "GET" && injected.CompareAndSwap(false, true) {
+			resp.Body.Close()
+			resp.Body = &nasSlowBody{ReadCloser: io.NopCloser(bytes.NewReader(bytes.Repeat([]byte("X"), len(good.Content))))}
+		}
+		return resp, err
+	})})
+	if err != nil {
+		t.Fatal(err)
+	}
+	h.k.Hub = client
