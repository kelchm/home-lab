diff --git a/internal/keep/import_eval.go b/internal/keep/import_eval.go
new file mode 100644
index 0000000..acf364c
--- /dev/null
+++ b/internal/keep/import_eval.go
@@ -0,0 +1,104 @@
+package keep
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"os"
+	"path/filepath"
+
+	"github.com/afshinghezeli/weightkeep/internal/fetch"
+	"github.com/afshinghezeli/weightkeep/internal/hub"
+	"github.com/afshinghezeli/weightkeep/internal/ids"
+	"github.com/afshinghezeli/weightkeep/internal/manifest"
+	"github.com/afshinghezeli/weightkeep/internal/store"
+)
+
+// ImportDirectoryRequest is an evaluation prototype, not a finished scanner.
+// Directory may be an HF snapshot containing symlinks or a plain model folder.
+// SourcePaths maps upstream paths to renamed local paths when necessary.
+type ImportDirectoryRequest struct {
+	Repo        hub.Repo
+	Revision    string
+	Directory   string
+	SourcePaths map[string]string
+}
+
+type ImportDirectoryResult struct {
+	Manifest                  *manifest.Manifest
+	Imported, Reused, Missing []string
+}
+
+// ImportDirectory asks the Hub for metadata only. It verifies local bytes using
+// upstream hashes and writes them through the existing content-addressed store.
+// Missing LFS files remain on-demand. Missing regular files currently prevent
+// publishing because format v1 requires a SHA-256 for every manifest entry.
+func (k *Keeper) ImportDirectory(ctx context.Context, req ImportDirectoryRequest) (*ImportDirectoryResult, error) {
+	if err := ids.ValidateRepoID(req.Repo.ID); err != nil {
+		return nil, err
+	}
+	rev := req.Revision
+	if rev == "" {
+		rev = "main"
+	}
+	info, client, err := k.repoInfo(ctx, req.Repo, rev)
+	if err != nil {
+		return nil, err
+	}
+	req.Repo.ID = info.ID
+	m, err := k.buildManifest(ctx, client, req.Repo, info)
+	if err != nil {
+		return nil, err
+	}
+	res := &ImportDirectoryResult{Manifest: m}
+	for i, f := range m.Files {
+		t := fetch.Target{Repo: req.Repo, Commit: m.Commit, Path: f.Path, Size: f.Size, TreeOID: f.GitSHA1, LFS: f.LFS, SHA256: f.SHA256}
+		if b, ok := k.Fetcher.Have(ctx, t); ok {
+			m.Files[i].SHA256 = b.SHA256
+			res.Reused = append(res.Reused, f.Path)
+			continue
+		}
+		source := f.Path
+		if mapped, ok := req.SourcePaths[f.Path]; ok {
+			source = mapped
+		}
+		if err := ids.ValidatePath(source); err != nil {
+			return res, err
+		}
+		file, err := os.Open(filepath.Join(req.Directory, filepath.FromSlash(source)))
+		if errors.Is(err, os.ErrNotExist) {
+			res.Missing = append(res.Missing, f.Path)
+			if !f.LFS {
+				return res, fmt.Errorf("missing regular file %s: manifest v1 needs its content hash", f.Path)
+			}
+			continue
+		}
+		if err != nil {
+			return res, err
+		}
+		exp := store.Expect{Size: f.Size, HasSize: true, SHA256: f.SHA256}
+		if !f.LFS {
+			exp.GitSHA1 = f.GitSHA1
+		}
+		b, err := k.Store.Put(ctx, file, exp)
+		closeErr := file.Close()
+		if err != nil {
+			return res, fmt.Errorf("import %s: %w", f.Path, err)
+		}
+		if closeErr != nil {
+			return res, closeErr
+		}
+		m.Files[i].SHA256 = b.SHA256
+		res.Imported = append(res.Imported, f.Path)
+	}
+	if err := manifest.Save(ctx, k.Store, m); err != nil {
+		return res, err
+	}
+	if err := manifest.SaveInfo(k.Store, m.Repo, m.Commit, info.Raw); err != nil {
+		return res, err
+	}
+	if err := manifest.SetRef(ctx, k.Store, m.Repo, rev, m.Commit, k.now()); err != nil {
+		return res, err
+	}
+	return res, nil
+}
