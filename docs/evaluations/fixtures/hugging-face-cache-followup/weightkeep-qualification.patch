+except Exception as e:
+ print(json.dumps({"corrupt_attempt_refused":True,"error":type(e).__name__}))
+else:
+ raise RuntimeError("corrupt attempt succeeded")
+p=hf_hub_download("acme/tiny","model.safetensors",cache_dir=sys.argv[2],endpoint=sys.argv[1],token=False)
+b=open(p,"rb").read();actual=hashlib.sha256(b).hexdigest()
+print(json.dumps({"sdk_returned_success":True,"bytes":len(b),"hash_matches":actual==sys.argv[3],"actual_sha256":actual,"expected_sha256":sys.argv[3]}))
+sys.exit(0 if actual==sys.argv[3] else 2)
+`
+	cmd := exec.CommandContext(ctx, "rtk", "proxy", "uv", "run", "--no-project", "--with", "huggingface-hub==2.0.0", "python", "-c", code, h.proxy.URL, t.TempDir(), good.SHA256())
+	cmd.Env = append(os.Environ(), "HF_HUB_DISABLE_PROGRESS_BARS=1", "HF_HUB_DISABLE_TELEMETRY=1", "HF_HOME="+t.TempDir())
+	output, err := cmd.CombinedOutput()
+	t.Logf("SDK output:\n%s", output)
+	t.Logf("upstream payload requests=%d verified store has good blob=%v", h.cdnRequests(), h.st.Has(good.SHA256()))
+	if err != nil {
+		t.Fatalf("SDK integrity qualification failed: %v", err)
+	}
+}
+
+func TestNASEvalVerifiedColdCancellation(t *testing.T) {
+	h := newHarness(t, Options{VerifyBeforeServe: true})
+	release := make(chan struct{})
+	var once sync.Once
+	unblock := func() { once.Do(func() { close(release) }) }
+	defer unblock()
+	client, err := hub.New(h.up.URL, hub.Options{Transport: nasRoundTrip(func(r *http.Request) (*http.Response, error) {
+		resp, err := http.DefaultTransport.RoundTrip(r)
+		if err == nil && strings.HasPrefix(r.URL.String(), h.up.CDN) {
+			resp.Body = &nasGateBody{ReadCloser: resp.Body, release: release}
+		}
+		return resp, err
+	})})
+	if err != nil {
+		t.Fatal(err)
+	}
+	h.k.Hub = client
+	h.k.Fetcher.Hub = client
+	h.do(t, http.MethodHead, "/acme/tiny/resolve/main/model.safetensors", nil)
+	short := &http.Client{Timeout: 50 * time.Millisecond}
+	_, err = short.Get(h.proxy.URL + "/acme/tiny/resolve/main/model.safetensors")
+	if err == nil {
+		t.Fatal("cold client unexpectedly finished before verification")
+	}
+	unblock()
+	resp, body := h.do(t, http.MethodGet, "/acme/tiny/resolve/main/model.safetensors", nil)
+	if resp.StatusCode != 200 || !bytes.Equal(body, weights.Content) {
+		t.Fatal("retry did not get valid content")
+	}
+	if n := h.cdnRequests(); n != 1 {
+		t.Errorf("payload GETs=%d", n)
+	}
+	t.Log("short cold client times out; ingest survives cancellation; retry gets verified bytes from the same single upstream download")
+}
+
+func TestNASEvalSDKColdTimeoutRetry(t *testing.T) {
+	h := newHarness(t, Options{VerifyBeforeServe: true})
+	release := make(chan struct{})
+	var once sync.Once
+	unblock := func() { once.Do(func() { close(release) }) }
+	defer unblock()
+	client, err := hub.New(h.up.URL, hub.Options{Transport: nasRoundTrip(func(r *http.Request) (*http.Response, error) {
+		resp, err := http.DefaultTransport.RoundTrip(r)
+		if err == nil && strings.HasPrefix(r.URL.String(), h.up.CDN) {
+			resp.Body = &nasGateBody{ReadCloser: resp.Body, release: release}
+			time.AfterFunc(12*time.Second, unblock)
+		}
+		return resp, err
+	})})
+	if err != nil {
+		t.Fatal(err)
+	}
+	h.k.Hub = client
+	h.k.Fetcher.Hub = client
+	h.do(t, http.MethodHead, "/acme/tiny/resolve/main/model.safetensors", nil)
+	ctx, cancel := context.WithTimeout(context.Background(), 35*time.Second)
+	defer cancel()
+	code := `import hashlib,json,sys
+from huggingface_hub import hf_hub_download, constants
+p=hf_hub_download("acme/tiny","model.safetensors",cache_dir=sys.argv[2],endpoint=sys.argv[1],token=False)
+actual=hashlib.sha256(open(p,"rb").read()).hexdigest()
+print(json.dumps({"timeout":constants.HF_HUB_DOWNLOAD_TIMEOUT,"hash_matches":actual==sys.argv[3]}))
+sys.exit(0 if actual==sys.argv[3] else 2)
+`
+	cmd := exec.CommandContext(ctx, "rtk", "proxy", "uv", "run", "--no-project", "--with", "huggingface-hub==2.0.0", "python", "-c", code, h.proxy.URL, t.TempDir(), weights.SHA256())
+	cmd.Env = append(os.Environ(), "HF_HUB_DISABLE_PROGRESS_BARS=1", "HF_HUB_DISABLE_TELEMETRY=1", "HF_HOME="+t.TempDir(), "HF_HUB_DOWNLOAD_TIMEOUT=10")
+	output, err := cmd.CombinedOutput()
+	t.Logf("SDK cold timeout output:\n%s", output)
+	if err != nil {
+		t.Fatalf("SDK cold timeout: %v", err)
+	}
+	if !strings.Contains(string(output), "Trying to resume") {
+		t.Fatal("SDK did not exercise timeout retry")
+	}
+	if n := h.cdnRequests(); n != 1 {
+		t.Errorf("payload GETs=%d, want 1", n)
+	}
+}
