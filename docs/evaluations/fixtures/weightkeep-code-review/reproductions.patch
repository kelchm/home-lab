+	"testing"
+	"time"
+)
+
+func TestReviewUpstreamWriteDelegation(t *testing.T) {
+	h := newHarness(t, Options{})
+	var seenMethod, seenBody string
+	var serverAuth bool
+	up := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		seenMethod = r.Method
+		b, _ := io.ReadAll(r.Body)
+		seenBody = string(b)
+		serverAuth = r.Header.Get("Authorization") == "Bearer hf_review_test"
+		w.Header().Set("Content-Type", "application/json")
+		io.WriteString(w, `{"ok":true}`)
+	}))
+	defer up.Close()
+	client, err := hub.New(up.URL, hub.Options{Token: config.NewToken("hf_review_test")})
+	if err != nil {
+		t.Fatal(err)
+	}
+	h.k.Hub = client
+	req, _ := http.NewRequestWithContext(context.Background(), "DELETE", h.proxy.URL+"/api/repos/delete", strings.NewReader(`{"name":"owner/model","type":"model"}`))
+	req.Header.Set("Content-Type", "application/json")
+	resp, err := http.DefaultClient.Do(req)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer resp.Body.Close()
+	if seenMethod != "DELETE" || !serverAuth || !strings.Contains(seenBody, "owner/model") {
+		t.Fatalf("delegation not reproduced: method=%s server_token=%v", seenMethod, serverAuth)
+	}
+	t.Logf("unauthenticated local DELETE forwarded with server token; status=%d", resp.StatusCode)
+}
+
+type reviewTransport func(*http.Request) (*http.Response, error)
+
+func (f reviewTransport) RoundTrip(r *http.Request) (*http.Response, error) { return f(r) }
+func TestReviewCachedModelMetadataTimeout(t *testing.T) {
+	h := newHarness(t, Options{RefTTL: time.Nanosecond})
+	resp, body := h.do(t, http.MethodGet, "/acme/tiny/resolve/main/model.safetensors", nil)
+	if resp.StatusCode != 200 || len(body) != len(weights.Content) {
+		t.Fatal("warmup failed")
+	}
+	client, err := hub.New(h.up.URL, hub.Options{APITimeout: 20 * time.Millisecond, Transport: reviewTransport(func(r *http.Request) (*http.Response, error) {
+		<-r.Context().Done()
+		return nil, r.Context().Err()
+	})})
+	if err != nil {
+		t.Fatal(err)
+	}
+	h.k.Hub = client
+	h.k.Fetcher.Hub = client
+	resp, body = h.do(t, http.MethodGet, "/acme/tiny/resolve/main/model.safetensors", nil)
+	if resp.StatusCode != 504 || !h.st.Has(weights.SHA256()) {
+		t.Fatalf("not reproduced: status=%d", resp.StatusCode)
+	}
+	t.Logf("cached model exists, expired main + metadata timeout returns %d instead of cached bytes", resp.StatusCode)
+}
+
+func TestReviewOllamaGeneratedBlobGC(t *testing.T) {
+	h := newHarness(t, Options{})
+	h.k.Now = time.Now
+	h.up.Add(&fakehub.Repo{ID: "acme/gguf", License: "apache-2.0", Files: []fakehub.File{cfgFile, gguf}})
+	blobs := pullLikeOllama(t, h.proxy.URL, "acme/gguf", "Q4_K_M")
+	var generated string
+	for d := range blobs {
+		if d != "sha256:"+gguf.SHA256() {
+			generated = strings.TrimPrefix(d, "sha256:")
+		}
+	}
+	if generated == "" || !h.st.Has(generated) {
+		t.Fatal("generated blob not present")
+	}
+	age := time.Now().Add(-2 * time.Hour)
+	if err := os.Chtimes(h.st.Path(generated), age, age); err != nil {
+		t.Fatal(err)
+	}
+	_, err := h.k.GC(context.Background(), keep.GCOptions{Grace: keep.DefaultGrace})
+	if err != nil {
+		t.Fatal(err)
+	}
+	rec := httptest.NewRecorder()
+	req := httptest.NewRequest("HEAD", "/v2/acme/gguf/blobs/sha256:"+generated, nil)
+	New(h.k, Options{Offline: true}).ServeHTTP(rec, req)
+	if h.st.Has(generated) || rec.Code != 404 {
+		t.Fatalf("not reproduced: status=%d", rec.Code)
+	}
+	t.Log("GC deleted generated config referenced by cached Ollama manifest; offline blob HEAD now 404")
+}
