+package hfcache
+
+import (
+	"bytes"
+	"context"
+	"github.com/afshinghezeli/weightkeep/internal/manifest"
+	"github.com/afshinghezeli/weightkeep/internal/store"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+)
+
+func reviewFixture(t *testing.T) (*store.Store, *manifest.Manifest) {
+	t.Helper()
+	st, err := store.Open(context.Background(), t.TempDir())
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { st.Close() })
+	b, err := st.Put(context.Background(), bytes.NewReader([]byte("GOOD")), store.Expect{})
+	if err != nil {
+		t.Fatal(err)
+	}
+	m := &manifest.Manifest{Version: 1, Repo: manifest.Repo{Type: "model", ID: "acme/model"}, Commit: strings.Repeat("a", 40), Files: []manifest.File{{Path: "model.bin", Size: 4, SHA256: b.SHA256, GitSHA1: b.GitSHA1, LFS: true}}}
+	return st, m
+}
+func TestReviewSameSizeCorruptExport(t *testing.T) {
+	st, m := reviewFixture(t)
+	dir := t.TempDir()
+	p := filepath.Join(dir, "model.bin")
+	if err := os.WriteFile(p, []byte("EVIL"), 0644); err != nil {
+		t.Fatal(err)
+	}
+	res, err := ToDir(context.Background(), st, m, dir, Copy)
+	if err != nil {
+		t.Fatal(err)
+	}
+	got, _ := os.ReadFile(p)
+	if string(got) != "EVIL" || res.Existing != 1 {
+		t.Fatal("not reproduced")
+	}
+	t.Log("export reports existing success despite wrong SHA-256")
+}
+func TestReviewSymlinkExportEscape(t *testing.T) {
+	st, m := reviewFixture(t)
+	m.Files[0].Path = "sub/model.bin"
+	dir := t.TempDir()
+	outside := t.TempDir()
+	if err := os.Symlink(outside, filepath.Join(dir, "sub")); err != nil {
+		t.Fatal(err)
+	}
+	_, err := ToDir(context.Background(), st, m, dir, Copy)
+	if err != nil {
+		t.Fatal(err)
+	}
+	got, err := os.ReadFile(filepath.Join(outside, "model.bin"))
+	if err != nil || string(got) != "GOOD" {
+		t.Fatal("not reproduced")
+	}
+	t.Log("export wrote outside requested directory through existing parent symlink")
+}
