+package keep
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"github.com/afshinghezeli/weightkeep/internal/fetch"
+	"github.com/afshinghezeli/weightkeep/internal/hub"
+	"github.com/afshinghezeli/weightkeep/internal/manifest"
+	"github.com/afshinghezeli/weightkeep/internal/policy"
+	"github.com/afshinghezeli/weightkeep/internal/store"
+	"github.com/afshinghezeli/weightkeep/internal/testutil/fakehub"
+	"io"
+	"net/http"
+	"os"
+	"strings"
+	"testing"
+	"time"
+)
+
+type reviewTransport func(*http.Request) (*http.Response, error)
+
+func (f reviewTransport) RoundTrip(r *http.Request) (*http.Response, error) { return f(r) }
+func TestReviewPrivateRepositorySeeded(t *testing.T) {
+	k, h := newKeeper(t)
+	text, _ := policy.Text("MIT")
+	h.Add(&fakehub.Repo{ID: "acme/private", License: "mit", Files: []fakehub.File{{Path: "LICENSE", Content: []byte(text)}, {Path: "model.bin", Content: []byte("secret weight"), LFS: true}}})
+	client, err := hub.New(h.URL, hub.Options{Transport: reviewTransport(func(r *http.Request) (*http.Response, error) {
+		resp, err := http.DefaultTransport.RoundTrip(r)
+		if err == nil && strings.Contains(r.URL.Path, "/api/models/") && !strings.Contains(r.URL.Path, "/tree/") {
+			b, e := io.ReadAll(resp.Body)
+			resp.Body.Close()
+			if e != nil {
+				return nil, e
+			}
+			var v map[string]any
+			if json.Unmarshal(b, &v) == nil {
+				v["private"] = true
+				b, _ = json.Marshal(v)
+			}
+			resp.Body = io.NopCloser(bytes.NewReader(b))
+			resp.ContentLength = int64(len(b))
+		}
+		return resp, err
+	})})
+	if err != nil {
+		t.Fatal(err)
+	}
+	k.Hub = client
+	k.Fetcher.Hub = client
+	res, err := k.Pull(context.Background(), PullRequest{Repo: hub.Repo{Type: hub.Model, ID: "acme/private"}})
+	if err != nil {
+		t.Fatal(err)
+	}
+	raw, err := manifest.LoadInfo(k.Store, res.Manifest.Repo, res.Manifest.Commit)
+	if err != nil || !bytes.Contains(raw, []byte(`"private":true`)) {
+		t.Fatal("private metadata not established")
+	}
+	plan, err := k.SeedPlan(context.Background(), Selector{Repo: res.Manifest.Repo}, SeedOptions{})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(plan) != 1 || !plan[0].Seed || plan[0].Decision.Tier != policy.A {
+		t.Fatal("not reproduced")
+	}
+	t.Log("private:true persists in raw metadata, but default seed plan allows tier A sharing")
+}
+func TestReviewManifestIndexFailureGC(t *testing.T) {
+	k, _ := newKeeper(t)
+	k.Now = time.Now
+	ctx := context.Background()
+	b, err := k.Store.Put(ctx, bytes.NewReader([]byte("GOOD")), store.Expect{})
+	if err != nil {
+		t.Fatal(err)
+	}
+	m := &manifest.Manifest{Version: 1, Repo: manifest.Repo{Type: "model", ID: "acme/canceled"}, Commit: strings.Repeat("a", 40), FetchedAt: time.Now(), Files: []manifest.File{{Path: "model.bin", Size: 4, SHA256: b.SHA256, GitSHA1: b.GitSHA1, LFS: true}}}
+	canceled, cancel := context.WithCancel(ctx)
+	cancel()
+	if err := manifest.Save(canceled, k.Store, m); err == nil {
+		t.Fatal("expected index cancellation")
+	}
+	if _, err := manifest.Load(ctx, k.Store, m.Repo, m.Commit); err != nil {
+		t.Fatalf("manifest not readable: %v", err)
+	}
+	age := time.Now().Add(-2 * time.Hour)
+	if err := os.Chtimes(k.Store.Path(b.SHA256), age, age); err != nil {
+		t.Fatal(err)
+	}
+	res, err := k.GC(ctx, GCOptions{Grace: DefaultGrace})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if k.Store.Has(b.SHA256) || len(res.Blobs) != 1 {
+		t.Fatal("not reproduced")
+	}
+	t.Log("readable durable manifest survives indexing failure, but GC deletes its recorded content")
+}
+
+type reviewGateReader struct {
+	io.ReadCloser
+	gate <-chan struct{}
+}
+
+func (r *reviewGateReader) Read(b []byte) (int, error) { <-r.gate; return r.ReadCloser.Read(b) }
+func TestReviewGCActiveLongPull(t *testing.T) {
+	k, h := newKeeper(t)
+	k.Now = time.Now
+	k.Fetcher.Parallel = 2
+	config := fakehub.File{Path: "config.json", Content: []byte(`{"long_pull":true}`)}
+	weight := fakehub.File{Path: "weight.bin", Content: []byte("large weight represented by stalled fixture"), LFS: true}
+	h.Add(&fakehub.Repo{ID: "acme/long", License: "mit", Files: []fakehub.File{config, weight}})
+	gate := make(chan struct{})
+	defer func() {
+		select {
+		case <-gate:
+		default:
+			close(gate)
+		}
+	}()
+	client, err := hub.New(h.URL, hub.Options{Transport: reviewTransport(func(r *http.Request) (*http.Response, error) {
+		resp, err := http.DefaultTransport.RoundTrip(r)
+		if err == nil && strings.HasPrefix(r.URL.String(), h.CDN) {
+			resp.Body = &reviewGateReader{ReadCloser: resp.Body, gate: gate}
+		}
+		return resp, err
+	})})
+	if err != nil {
+		t.Fatal(err)
+	}
+	k.Hub = client
+	k.Fetcher.Hub = client
+	early := make(chan struct{})
+	k.Fetcher.Events = func(e fetch.Event) {
+		if e.State == fetch.Done && e.Path == config.Path {
+			age := time.Now().Add(-2 * time.Hour)
+			if err := os.Chtimes(k.Store.Path(config.SHA256()), age, age); err != nil {
+				t.Error(err)
+			}
+			close(early)
+		}
+	}
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+	done := make(chan error, 1)
+	go func() {
+		_, err := k.Pull(ctx, PullRequest{Repo: hub.Repo{Type: hub.Model, ID: "acme/long"}})
+		done <- err
+	}()
+	select {
+	case <-early:
+	case <-time.After(3 * time.Second):
+		t.Fatal("no early blob")
+	}
+	gc, err := k.GC(context.Background(), GCOptions{Grace: DefaultGrace})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if k.Store.Has(config.SHA256()) || len(gc.Blobs) != 1 {
+		t.Fatal("not reproduced")
+	}
+	t.Log("GC deleted the active pull's early blob once its age exceeded the one-hour grace")
+	cancel()
+	// Release body before waiting for worker shutdown; all mutation stays in scratch.
+	close(gate)
+	select {
+	case <-done:
+	case <-time.After(3 * time.Second):
+		t.Fatal("pull failed to stop")
+	}
+}
