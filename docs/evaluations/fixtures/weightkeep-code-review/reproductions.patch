+package torrent
+
+import (
+	"context"
+	"github.com/anacrolix/torrent/bencode"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+	"time"
+)
+
+func TestReviewTorrentStorageBeforeValidation(t *testing.T) {
+	st, _ := keptRevision(t, map[string][]byte{"safe.bin": []byte("safe")})
+	c, err := NewClient(st, ClientConfig{DataDir: t.TempDir(), NoDHT: true, NoWebSeeds: true})
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer c.Close()
+	base := t.TempDir()
+	sentinel := filepath.Join(base, "sentinel")
+	if err := os.WriteFile(sentinel, []byte("KEEP"), 0644); err != nil {
+		t.Fatal(err)
+	}
+	info := map[string]any{"name": strings.Repeat("a", 40), "piece length": int64(16384), "pieces": "", "files": []any{map[string]any{"length": int64(0), "path": []string{"..", "..", "sentinel"}}}}
+	ib, err := bencode.Marshal(info)
+	if err != nil {
+		t.Fatal(err)
+	}
+	meta, err := bencode.Marshal(map[string]any{"info": bencode.Bytes(ib)})
+	if err != nil {
+		t.Fatal(err)
+	}
+	ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
+	defer cancel()
+	_, err = c.Fetch(ctx, Source{MetaInfo: meta}, filepath.Join(base, "ingest"), nil, func(string) bool { return false })
+	got, readErr := os.ReadFile(sentinel)
+	if readErr != nil || len(got) != 0 {
+		t.Fatalf("not reproduced: content=%q readErr=%v fetchErr=%v", got, readErr, err)
+	}
+	t.Logf("malformed torrent rejected (%v), after truncating file outside ingest directory", err)
+}
