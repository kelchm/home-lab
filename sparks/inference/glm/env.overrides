# Site overrides for MiaAI-Lab's GLM-5.3-Flash EXL3 guide.
#
# Upstream: github.com/MiaAI-Lab/GLM-5.3-Flash-EXL3-2x-DGX-Sparks
# Start from the pinned guide's .env.example, then apply these. The Ansible
# profile starts fully offline and verifies every line here against the live
# head .env before it launches either rank.
#
# The rendezvous, worker SSH, NCCL bootstrap, and NCCL data path all use
# fabric-a. NET/IB in the launch logs is the proof that NCCL stayed on RoCE.

HEAD_IP=198.19.240.11
WORKER_IP=198.19.240.12
WORKER_USER=kelchm
WORKER_HOME=/home/kelchm
WORKER_SSH=kelchm@198.19.240.12
HEAD_CX7_IF=enp1s0f0np0
WORKER_CX7_IF=enp1s0f0np0
HEAD_CX7_IB=rocep1s0f0
WORKER_CX7_IB=rocep1s0f0
NCCL_IB_GID_INDEX=3
NCCL_DEBUG=INFO

MODEL=Mia-AiLab/GLM-5.3-Flash-EXL3-TR3-4bpw
MODEL_FALLBACK=brandonmusic/GLM-5.3-Flash-tr3-4bpw
MODEL_REVISION=25a44fdbf16862a46b7cc9921142c6c81350af2f
HF_HOME=/home/kelchm/.cache/huggingface
HF_BIN=/home/kelchm/.hf-cli/venv/bin/hf
IMAGE=ghcr.io/miaai-lab/glm-5.3-flash-2x-dgx-sparks@sha256:9bb1557a4234fce63d59599e44d10747eabd742beb337eebf9e7070be8a0fd58

PORT=8888
TP=2
NNODES=2
MASTER_PORT=29521
QUANTIZATION=exl3
SERVED_MODEL_NAME=GLM-5.3-Flash-EXL3
SPEC_METHOD=dflash
DFLASH_MODEL=incoai/GLM-5.3-Flash-DFlash2
DFLASH_TOKENS=7
MAX_MODEL_LEN=1000000
MAX_NUM_SEQS=4
MAX_NUM_BATCHED_TOKENS=2048
GPU_MEM_UTIL=0.87
KV_CACHE_DTYPE=fp8
LANGUAGE_MODEL_ONLY=0
SKIP_MM_PROFILING=1
LIMIT_MM='{"image":4,"video":1}'
USE_HOST_NCCL=0
