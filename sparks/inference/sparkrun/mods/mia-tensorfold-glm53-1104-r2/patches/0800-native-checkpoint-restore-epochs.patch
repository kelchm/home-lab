+                    _ = sys.c.unlink(dest);
+                    // An uncertain failed publication never removes a previous epoch. Attempt to persist rollback.
+                    _ = sys.c.fsync(fd);
+                }
+                if (sys.c.unlink(w.tmp[0..w.tmp_len :0]) != 0) return error.CheckpointPublish;
