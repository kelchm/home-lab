+}
+
+/// Compact libjpeg's four-component output to RGB in place. TurboJPEG delegates YCCK -> CMYK to libjpeg;
+/// Pillow's JpegImagePlugin then uses CMYK;I even WITHOUT an Adobe APP14 marker (invert all four channels).
+/// Convert.c:cmyk2rgb is nk - MULDIV255(c, nk), with nk = 255-k after that inversion. This is not an ICC
+/// conversion. Keep Pillow's exact integer rounding rather than the codec's approximate CMYK -> RGB path.
+/// The allocation retains its original length so the caller can free it; only its first pixels*3 bytes are RGB.
+fn cmykToRgb(bytes: []u8, pixels: usize) void {
+    for (0..pixels) |i| {
+        // Read the whole source pixel before compacting: destination and source overlap at the first pixels.
+        const ink = bytes[i * 4 ..][0..4].*;
+        const nk: u32 = ink[3];
+        for (0..3) |c| {
+            const t = @as(u32, 255 - ink[c]) * nk + 128;
+            bytes[i * 3 + c] = @intCast(nk - ((t + (t >> 8)) >> 8));
+        }
+    }
 }
 
