diff --git a/zig/src/server/delivered_calls.zig b/zig/src/server/delivered_calls.zig
new file mode 100644
--- /dev/null
+++ b/zig/src/server/delivered_calls.zig
@@ -0,0 +1,67 @@
+//! Track the call IDs and arguments actually emitted, not IDs regenerated by the final parser.
+const std = @import("std");
+const json = @import("json");
+const Value = json.Value;
+const Allocator = std.mem.Allocator;
+const max_calls = @import("reasoning_cache.zig").max_calls;
+
+pub const Delivered = struct {
+    calls: std.ArrayList(Call) = .empty,
+    bytes: usize = 0,
+    valid: bool = true,
+    const Call = struct { id: []const u8, name: []const u8, arguments: std.ArrayList(u8) = .empty };
+    const max_bytes = 32 << 20;
+
+    /// After a successful event write; failure to track disables caching without changing the response.
+    pub fn note(d: *Delivered, a: Allocator, delta: Value) void {
+        if (!d.valid) return;
+        d.track(a, delta) catch {
+            d.valid = false;
+        };
+    }
+
+    fn track(d: *Delivered, a: Allocator, delta: Value) !void {
+        const calls = delta.get("tool_calls") orelse return;
+        if (calls != .array) return error.Invalid;
+        for (calls.array) |call| {
+            const index = (call.get("index") orelse return error.Invalid).int64() orelse return error.Invalid;
+            if (index < 0 or index >= max_calls) return error.Invalid;
+            const at: usize = @intCast(index);
+            const function = call.get("function") orelse return error.Invalid;
+            if (at == d.calls.items.len) {
+                const id = call.strField("id") orelse return error.Invalid;
+                const name = function.strField("name") orelse return error.Invalid;
+                if (id.len == 0 or id.len > 256 or name.len == 0 or name.len > 4096) return error.Invalid;
+                try d.calls.append(a, .{ .id = try a.dupe(u8, id), .name = try a.dupe(u8, name) });
+            } else if (at > d.calls.items.len or call.has("id") or function.has("name")) return error.Invalid;
+            const piece = function.strField("arguments") orelse "";
+            if (piece.len > max_bytes -| d.bytes) return error.Invalid;
+            try d.calls.items[at].arguments.appendSlice(a, piece);
+            d.bytes += piece.len;
+        }
+    }
+
+    /// Only accept the same complete calls in order; no name/argument search or identity inference.
+    pub fn ids(d: *const Delivered, a: Allocator, parsed: []const Value) Allocator.Error!?[][]const u8 {
+        if (!d.valid or d.calls.items.len == 0 or parsed.len != d.calls.items.len) return null;
+        const out = try a.alloc([]const u8, parsed.len);
+        for (d.calls.items, parsed, out) |sent, call, *id| {
+            const function = call.get("function") orelse return null;
+            if (!std.mem.eql(u8, sent.name, function.strField("name") orelse "")) return null;
+            const args = function.strField("arguments") orelse return null;
+            const expected = try json.parseText(a, args);
+            const delivered = try json.parseText(a, sent.arguments.items);
+            if (expected != .ok or delivered != .ok or expected.ok != .object or delivered.ok != .object or
+                !json.equal(expected.ok, delivered.ok)) return null;
+            id.* = sent.id;
+        }
+        return out;
+    }
+};
+
+pub fn idsOf(a: Allocator, calls: []const Value) Allocator.Error!?[][]const u8 {
+    if (calls.len == 0 or calls.len > max_calls) return null;
+    const out = try a.alloc([]const u8, calls.len);
+    for (calls, out) |call, *id| id.* = call.strField("id") orelse return null;
+    return out;
+}
diff --git a/zig/src/server/history_contract.zig b/zig/src/server/history_contract.zig
new file mode 100644
--- /dev/null
+++ b/zig/src/server/history_contract.zig
@@ -0,0 +1,52 @@
+//! Preserve caller reasoning and refuse tool-result identities a sorting template would silently omit.
+const std = @import("std");
+const json = @import("json");
+const errors = @import("errors.zig");
+const strip = @import("reply_text.zig").pyStrip;
+const Value = json.Value;
+
+pub fn reasoningAlias(cx: *errors.Cx, item: *json.Object) std.mem.Allocator.Error!*json.Object {
+    const value: Value = .{ .object = item };
+    if (!std.mem.eql(u8, value.strField("role") orelse "", "assistant")) return item;
+    if (strip(value.strField("reasoning_content") orelse "").len > 0) return item;
+    const alias = value.strField("reasoning") orelse return item;
+    if (strip(alias).len == 0) return item;
+    const copy = try json.copyObject(cx.a, item);
+    try copy.put(cx.a, "reasoning_content", .{ .string = alias });
+    return copy;
+}
+
+fn idOf(value: Value) ?Value {
+    const tool_id = value.get("tool_call_id");
+    if (tool_id != null and tool_id.?.truthy()) return tool_id;
+    return value.get("id");
+}
+
+pub fn toolResults(cx: *errors.Cx, messages: []const Value) errors.Refused!void {
+    var preceding: ?[]const Value = null;
+    for (messages, 0..) |message, index| {
+        const role = message.strField("role") orelse "";
+        if (!std.mem.eql(u8, role, "tool")) {
+            preceding = null;
+            if (std.mem.eql(u8, role, "assistant")) if (message.get("tool_calls")) |calls| {
+                if (calls == .array and calls.array.len > 0) preceding = calls.array;
+            };
+            continue;
+        }
+        const value = idOf(message) orelse continue;
+        if (value == .null or (value == .string and value.string.len == 0)) continue;
+        if (value != .string) return cx.fail(.request, "messages[{d}].tool_call_id must be a string", .{index});
+        // With no preceding call list, the template renders this block in its original order.
+        const calls = preceding orelse continue;
+        // A call without an ID disables sorting; leave that lossless fallback intact.
+        const identified = for (calls) |call| {
+            const id = idOf(call) orelse break false;
+            if (!id.truthy()) break false;
+        } else true;
+        if (!identified) continue;
+        for (calls) |call| {
+            const id = idOf(call) orelse continue;
+            if (id == .string and std.mem.eql(u8, id.string, value.string)) break;
+        } else return cx.fail(.request, "messages[{d}].tool_call_id does not match the preceding assistant tool_calls", .{index});
+    }
+}
