+++ b/zig/src/core/checkpoint_capture_test.zig
@@ -0,0 +1,103 @@
+const std = @import("std");
+const kv = @import("kv_pool.zig");
+const cap = @import("checkpoint_capture.zig");
+const t = std.testing;
+
+test "checkpoint bounded: four growing leases keep every promised page while checkpoints are undurable" {
+    var pool = try kv.Pool.init(t.allocator, 20, 4096);
+    defer pool.deinit();
+    var live: [4]kv.Lease = @splat(.{});
+    defer for (&live) |*l| pool.finish(l);
+    for (&live) |*l| {
+        try pool.promise(l, 5);
+        try pool.cover(l, 2, null);
+    }
+    var budget: cap.Budget = .{ .pool = &pool, .limits = .{ .descriptors = 4, .unique_pages = 8, .pages_per_descriptor = 5, .capsule_bytes = 64 } };
+    var saved: [4]cap.Lease = undefined;
+    for (&live, &saved) |*l, *s| s.* = try budget.acquire(l, 2, 16);
+    try t.expectEqual(@as(usize, 8), pool.npinned);
+    try t.expectEqual(@as(usize, 12), pool.promised);
+    try t.expectError(error.CheckpointBackpressure, budget.acquire(&live[0], 1, 1));
+    for (&live) |*l| try pool.cover(l, 5, null);
+    try t.expectEqual(@as(usize, 0), pool.nfree);
+    for (&live) |*l| pool.finish(l);
+    try t.expectEqual(@as(usize, 12), pool.available());
+    try t.expectEqual(@as(usize, 0), pool.reclaimable());
+    var next: kv.Lease = .{};
+    defer pool.finish(&next);
+    try t.expectError(error.LaneMemory, pool.promise(&next, 13));
+    for (&saved) |*s| try s.close();
+    try t.expectEqual(@as(usize, 20), pool.available());
+    try t.expectEqual(@as(usize, 0), budget.active + budget.capsule_used + pool.npinned);
+}
+
+test "checkpoint bounded: forks count shared physical pages once and pins are not cache refs" {
+    var pool = try kv.Pool.init(t.allocator, 6, 4096);
+    defer pool.deinit();
+    var parent: kv.Lease = .{};
+    defer pool.finish(&parent);
+    var fork: kv.Lease = .{};
+    defer pool.finish(&fork);
+    try pool.promise(&parent, 3);
+    try pool.cover(&parent, 3, null);
+    for (parent.ids.items[0..2]) |id| pool.retain(id);
+    try pool.adopt(&fork, parent.ids.items[0..2]);
+    var b: cap.Budget = .{ .pool = &pool, .limits = .{ .descriptors = 3, .unique_pages = 2, .pages_per_descriptor = 3, .capsule_bytes = 8 } };
+    var a = try b.acquire(&parent, 2, 4);
+    var f = try b.acquire(&fork, 2, 4);
+    try t.expectEqual(@as(usize, 2), pool.npinned);
+    try t.expectEqual(@as(u32, 2), pool.pins[0]);
+    try t.expectError(error.NotHeld, pool.drop(0));
+    try t.expectError(error.CheckpointBackpressure, b.acquire(&parent, 3, 0));
+    pool.finish(&parent);
+    pool.finish(&fork);
+    try t.expectEqual(@as(usize, 0), pool.reclaimable());
+    try a.close();
+    try t.expectEqual(@as(usize, 0), pool.reclaimable());
+    pool.retain(0); // an independent RAM-cache holder can release only its own reference
+    try pool.drop(0);
+    try t.expectError(error.NotHeld, pool.drop(0));
+    try f.close();
+    try t.expectEqual(@as(usize, 6), pool.available());
+}
+
+test "checkpoint bounded: admission rejects malformed and excess metadata without leaking credits" {
+    var pool = try kv.Pool.init(t.allocator, 4, 4096);
+    defer pool.deinit();
+    var live: kv.Lease = .{};
+    defer pool.finish(&live);
+    try pool.promise(&live, 3);
+    try pool.cover(&live, 2, null);
+    var b: cap.Budget = .{ .pool = &pool, .limits = .{ .descriptors = 1, .unique_pages = 3, .pages_per_descriptor = 2, .capsule_bytes = 8 } };
+    try t.expectError(error.InvalidPages, b.acquire(&live, 3, 0));
+    try t.expectError(error.CheckpointBackpressure, b.acquire(&live, 1, 9));
+    const id = live.ids.items[1];
+    live.ids.items[1] = live.ids.items[0];
+    try t.expectError(error.InvalidPages, b.acquire(&live, 2, 0));
+    live.ids.items[1] = id;
+    var saved = try b.acquire(&live, 2, 8);
+    try saved.borrow();
+    try t.expectError(error.CheckpointBusy, saved.close());
+    saved.unborrow();
+    try saved.close();
+    try t.expectEqual(@as(usize, 0), pool.npinned + b.active + b.capsule_used);
+    try t.expectEqual(@as(usize, 1), pool.promised);
+}
+
+fn allocationFailures(a: std.mem.Allocator) !void {
+    var pool = try kv.Pool.init(a, 8, 4096);
+    defer pool.deinit();
+    var live: kv.Lease = .{};
+    defer pool.finish(&live);
+    try pool.promise(&live, 4);
+    try pool.cover(&live, 2, null);
+    var b: cap.Budget = .{ .pool = &pool, .limits = .{ .descriptors = 1, .unique_pages = 2, .pages_per_descriptor = 2, .capsule_bytes = 16 } };
+    var saved = try b.acquire(&live, 2, 16);
+    try saved.close();
+    try t.expectEqual(@as(usize, 0), pool.npinned + b.active + b.capsule_used);
+    try t.expectEqual(@as(usize, 2), pool.promised);
+}
+
+test "checkpoint bounded: every descriptor and pool allocation failure preserves ownership" {
+    try t.checkAllAllocationFailures(t.allocator, allocationFailures, .{});
+}
diff --git a/zig/src/core/checkpoint_file.zig b/zig/src/core/checkpoint_file.zig
new file mode 100644
--- /dev/null
+++ b/zig/src/core/checkpoint_file.zig
@@ -0,0 +1,127 @@
+//! Rank-local chunks: exclusive temporary, file fsync, no-replace link, directory fsync; no all-rank commit.
+const std = @import("std");
+const platform = @import("sys");
+const transfer = @import("checkpoint_stream.zig");
+
+pub const Identity = struct {
+    block: [32]u8, // rows_chain.Name, supplied by the row store owning that module
+    rank: u32,
+    epoch: u64,
+
+    /// The caller's existing rows/block identity, domain separated by the rank and checkpoint epoch.
+    pub fn name(id: Identity) [32]u8 {
+        var h = std.crypto.hash.sha2.Sha256.init(.{});
+        h.update("tensorfold checkpoint rank 1");
+        h.update(&id.block);
+        var words: [12]u8 = undefined;
+        std.mem.writeInt(u32, words[0..4], id.rank, .little);
+        std.mem.writeInt(u64, words[4..12], id.epoch, .little);
+        h.update(&words);
+        return h.finalResult();
+    }
+};
+
+/// Publication hooks allow deterministic filesystem-failure tests without global fault switches.
+pub const Publication = struct {
+    ctx: ?*anyopaque = null,
+    link: *const fn (?*anyopaque, [:0]const u8, [:0]const u8) anyerror!void = linkDefault,
+    sync_dir: *const fn (?*anyopaque, c_int) anyerror!void = syncDefault,
+
+    fn linkDefault(_: ?*anyopaque, from: [:0]const u8, to: [:0]const u8) !void {
+        if (std.c.link(from, to) != 0) return error.CheckpointPublish;
+    }
+    fn syncDefault(_: ?*anyopaque, fd: c_int) !void {
+        if (platform.c.fsync(fd) != 0) return error.CheckpointDirectorySync;
+    }
+};
+
+pub const Local = struct { identity: Identity, bytes: u64 };
+const Phase = enum { writing, sealed, published, failed, closed };
+
+/// Instantiate with the existing row store's file module, preserving its single module owner.
+pub fn Writer(comptime rows: type) type {
+    return struct {
+        const Self = @This();
+        file: rows.Writer,
+        dir_fd: c_int,
+        identity: Identity,
+        expected: u64,
+        metadata_limit: usize,
+        publication: Publication = .{},
+        phase: Phase = .writing,
+        linked: bool = false,
+        bytes: u64 = 0,
+
+        /// The directory already exists and belongs to this store. Rank files are invisible to the serving index.
+        pub fn open(dir: [:0]const u8, identity: Identity, nonce: u64, payload_bytes: u64, metadata_limit: usize) !Self {
+            if (@import("builtin").os.tag != .linux and @import("builtin").os.tag != .macos) return error.UnsupportedCheckpointFilesystem;
+            const fd = platform.c.open(dir, .{ .ACCMODE = .RDONLY, .DIRECTORY = true, .NOFOLLOW = true, .CLOEXEC = true }, @as(platform.c.mode_t, 0));
+            if (fd < 0) return error.CheckpointDirectory;
+            errdefer _ = platform.c.close(fd);
+            const stem = std.fmt.bytesToHex(identity.name(), .lower);
+            const file = try rows.Writer.openUnique(dir, &stem, ".rank", nonce);
+            return .{ .file = file, .dir_fd = fd, .identity = identity, .expected = payload_bytes, .metadata_limit = metadata_limit };
+        }
+
+        pub fn append(w: *Self, offset: u64, bytes: []const u8) !void {
+            if (w.phase != .writing) return error.CheckpointFileState;
+            if (offset != w.file.payload) return error.CheckpointSinkBackpressure;
+            if (bytes.len > w.expected - w.file.payload) return error.CheckpointFileSize;
+            w.file.append(bytes) catch |err| {
+                w.phase = .failed;
+                return err;
+            };
+        }
+
+        /// Sequential sink for ready ring slots; an out-of-order completion waits without borrowing its buffer.
+        pub fn consume(w: *Self, ring: *transfer.Ring, key: transfer.Key) !void {
+            const part = try ring.inspect(key);
+            if (part.offset != w.file.payload) return error.CheckpointSinkBackpressure;
+            const bytes = try ring.beginWrite(key);
+            w.append(part.offset, bytes) catch |err| {
+                try ring.ioDone(key, false);
+                return err;
+            };
+            try ring.ioDone(key, true);
+        }
+
+        /// Every chunk is drained before metadata/trailer and file fsync; no complete-payload staging buffer exists.
+        pub fn seal(w: *Self, ring: *const transfer.Ring, at: u32, metadata: []const []const u8) !void {
+            if (w.phase != .writing) return error.CheckpointFileState;
+            if (!ring.readyToSeal() or ring.written != w.expected or w.file.payload != w.expected) return error.CheckpointBusy;
+            var n: usize = 0;
+            for (metadata) |m| {
+                if (m.len > w.metadata_limit - n) return error.CheckpointMetadataLimit;
+                n += m.len;
+            }
+            w.bytes = w.file.seal(.{ .kind = @backingInt(rows.Kind.state), .payload = 0, .payload_hash = 0, .name = w.identity.name(), .at = at }, metadata, true) catch |err| {
+                w.phase = .failed;
+                return err;
+            };
+            w.phase = .sealed;
+        }
+
+        /// Hard-link publication never overwrites an existing epoch file; no receipt escapes a failed directory sync.
+        pub fn publish(w: *Self) !Local {
+            if (w.phase != .sealed) return error.CheckpointFileState;
+            errdefer w.phase = .failed;
+            try w.publication.link(w.publication.ctx, w.file.tmp[0..w.file.tmp_len :0], w.file.dest[0..w.file.dest_len :0]);
+            w.linked = true;
+            if (platform.c.unlink(w.file.tmp[0..w.file.tmp_len :0]) != 0) return error.CheckpointPublish;
+            try w.publication.sync_dir(w.publication.ctx, w.dir_fd);
+            w.phase = .published;
+            return .{ .identity = w.identity, .bytes = w.bytes };
+        }
+
+        /// A failed writer still requires the ring to drain before capture ownership can end.
+        pub fn close(w: *Self) void {
+            if (w.phase == .closed) return;
+            if (w.phase != .published) {
+                w.file.abort();
+                if (w.linked) _ = platform.c.unlink(w.file.dest[0..w.file.dest_len :0]);
+            }
+            _ = platform.c.close(w.dir_fd);
+            w.phase = .closed;
+        }
+    };
+}
diff --git a/zig/src/core/checkpoint_file_test.zig b/zig/src/core/checkpoint_file_test.zig
new file mode 100644
--- /dev/null
+++ b/zig/src/core/checkpoint_file_test.zig
@@ -0,0 +1,171 @@
+const std = @import("std");
+const platform = @import("sys");
+const file = @import("checkpoint_file.zig");
+const rows = @import("rows_file.zig");
+const Writer = file.Writer(rows);
+const stream = @import("checkpoint_stream.zig");
+const cap = @import("checkpoint_capture.zig");
+const kv = @import("kv_pool.zig");
+const t = std.testing;
+
+const Source = struct {
+    at: usize = 0,
+    data: []const u8 = "checkpoint payload with a short last chunk",
+    fn next(ptr: *anyopaque, n: usize) !?cap.Chunk {
+        const s: *Source = @ptrCast(@alignCast(ptr));
+        if (s.at == s.data.len) return null;
+        const len = @min(n, s.data.len - s.at);
+        const c: cap.Chunk = .{ .location = .{ .host = s.data[s.at..][0..len] }, .offset = s.at, .len = len };
+        s.at += len;
+        return c;
+    }
+};
+
+const Fault = struct {
+    mode: enum { ok, write, sync_file, link, sync_dir } = .ok,
+    phase: u8 = 0,
+    writes: usize = 0,
+
+    fn ctx(ptr: ?*anyopaque) *Fault {
+        return @ptrCast(@alignCast(ptr.?));
+    }
+    fn write(ptr: ?*anyopaque, fd: c_int, bytes: []const u8) !usize {
+        const f = ctx(ptr);
+        if (f.mode == .write and f.writes > 1) return error.InjectedWrite;
+        f.writes += 1;
+        const n = platform.c.write(fd, bytes.ptr, @min(bytes.len, 3));
+        if (n <= 0) return error.RowsWrite;
+        return @intCast(n);
+    }
+    fn syncFile(ptr: ?*anyopaque, fd: c_int) !void {
+        const f = ctx(ptr);
+        try t.expectEqual(@as(u8, 0), f.phase);
+        if (f.mode == .sync_file) return error.InjectedFileSync;
+        if (platform.c.fsync(fd) != 0) return error.RowsWrite;
+        f.phase = 1;
+    }
+    fn link(ptr: ?*anyopaque, from: [:0]const u8, to: [:0]const u8) !void {
+        const f = ctx(ptr);
+        try t.expectEqual(@as(u8, 1), f.phase);
+        if (f.mode == .link) return error.InjectedLink;
+        if (std.c.link(from, to) != 0) return error.CheckpointPublish;
+        f.phase = 2;
+    }
+    fn syncDir(ptr: ?*anyopaque, fd: c_int) !void {
+        const f = ctx(ptr);
+        try t.expectEqual(@as(u8, 2), f.phase);
+        if (f.mode == .sync_dir) return error.InjectedDirectorySync;
+        if (platform.c.fsync(fd) != 0) return error.RowsWrite;
+        f.phase = 3;
+    }
+};
+
+fn run(mode: @FieldType(Fault, "mode")) !void {
+    var dir_buf: [128]u8 = undefined;
+    const dir = try std.fmt.bufPrintSentinel(&dir_buf, "/tmp/tf-checkpoint-050-{d}-{s}", .{ platform.c.getpid(), @tagName(mode) }, 0);
+    try t.expectEqual(@as(c_int, 0), platform.c.mkdir(dir, 0o700));
+    defer _ = platform.c.rmdir(dir);
+    var pool = try kv.Pool.init(t.allocator, 0, 4096);
+    defer pool.deinit();
+    const live: kv.Lease = .{};
+    var budget: cap.Budget = .{ .pool = &pool, .limits = .{ .descriptors = 1, .unique_pages = 0, .pages_per_descriptor = 0, .capsule_bytes = 0 } };
+    var owner = try budget.acquire(&live, 0, 0);
+    defer owner.close() catch unreachable;
+    var s: Source = .{};
+    var slots: [2]stream.Slot = undefined;
+    var storage: [16]u8 = undefined;
+    var ring = try stream.Ring.init(.{ .owner = &owner, .ctx = &s, .len = s.data.len, .next = Source.next }, &storage, &slots, 8);
+    const identity: file.Identity = .{ .block = @splat(3), .rank = 1, .epoch = 12 };
+    var w = try Writer.open(dir, identity, 123, s.data.len, 32);
+    defer w.close();
+    try t.expectError(error.RowsWrite, Writer.open(dir, identity, 123, s.data.len, 32));
+    var fault: Fault = .{ .mode = mode };
+    w.file.io = .{ .ctx = &fault, .write = Fault.write, .sync = Fault.syncFile };
+    w.publication = .{ .ctx = &fault, .link = Fault.link, .sync_dir = Fault.syncDir };
+    const dest = w.file.dest[0..w.file.dest_len :0];
+    defer _ = platform.c.unlink(dest);
+    if (mode == .ok) {
+        const first = try ring.acquire();
+        const second = try ring.acquire();
+        @memcpy(second.target, second.chunk.location.host);
+        try ring.dmaDone(second.key, true);
+        try t.expectError(error.CheckpointSinkBackpressure, w.consume(&ring, second.key));
+        @memcpy(first.target, first.chunk.location.host);
+        try ring.dmaDone(first.key, true);
+        try w.consume(&ring, first.key);
+        try ring.retire(first.key);
+        try w.consume(&ring, second.key);
+        try ring.retire(second.key);
+    }
+    while (ring.emitted < s.data.len) {
+        const ticket = try ring.acquire();
+        @memcpy(ticket.target, ticket.chunk.location.host);
+        try ring.dmaDone(ticket.key, true);
+        if (mode == .write) {
+            try t.expectError(error.InjectedWrite, w.consume(&ring, ticket.key));
+            try ring.retire(ticket.key);
+            try ring.close();
+            try t.expectError(error.CheckpointFileState, w.seal(&ring, 2, &.{}));
+            w.close();
+            try t.expectError(error.RowsMissing, rows.open(dest, .state, null));
+            return;
+        }
+        try w.consume(&ring, ticket.key);
+        try t.expectError(error.CheckpointBusy, w.seal(&ring, 2, &.{})); // the slot is not retired yet
+        try ring.retire(ticket.key);
+    }
+    try t.expectError(error.CheckpointMetadataLimit, w.seal(&ring, 2, &.{"this metadata is deliberately more than thirty two bytes"}));
+    if (mode == .sync_file) {
+        try t.expectError(error.InjectedFileSync, w.seal(&ring, 2, &.{"metadata"}));
+    } else {
+        try w.seal(&ring, 2, &.{"metadata"});
+        try t.expectError(error.RowsMissing, rows.open(dest, .state, null));
+        if (mode == .link) {
+            try t.expectError(error.InjectedLink, w.publish());
+        } else if (mode == .sync_dir) {
+            try t.expectError(error.InjectedDirectorySync, w.publish());
+        } else {
+            const local = try w.publish();
+            try t.expectEqual(@as(u64, s.data.len + 8 + 96), local.bytes);
+            try t.expectEqual(@as(u8, 3), fault.phase);
+            var opened = try rows.open(dest, .state, identity.name());
+            defer opened.close();
+            const stage = try rows.stage(t.allocator, s.data.len);
+            defer t.allocator.free(stage);
+            try t.expectEqualSlices(u8, s.data, try rows.payload(&opened, stage));
+            const meta = try rows.meta(&opened, t.allocator);
+            defer t.allocator.free(meta);
+            try t.expectEqualStrings("metadata", meta);
+            // Another nonce cannot replace an existing immutable rank/epoch file.
+            var other = try Writer.open(dir, identity, 124, s.data.len, 32);
+            defer other.close();
+            try other.append(0, s.data);
+            try other.seal(&ring, 2, &.{"changed"});
+            try t.expectError(error.CheckpointPublish, other.publish());
+            try t.expectEqualSlices(u8, s.data, try rows.payload(&opened, stage));
+        }
+    }
+    try ring.close();
+    w.close();
+    if (mode != .ok) try t.expectError(error.RowsMissing, rows.open(dest, .state, null));
+    const tmp = w.file.tmp[0..w.file.tmp_len :0];
+    try t.expectError(error.RowsMissing, rows.open(tmp, .state, null));
+}
+
+test "checkpoint bounded: rank chunk writer streams short writes and orders fsync before exclusive publication" {
+    try run(.ok);
+}
+
+test "checkpoint bounded: write, file fsync, link and directory fsync failures never return local publication" {
+    for ([_]@FieldType(Fault, "mode"){ .write, .sync_file, .link, .sync_dir }) |mode| try run(mode);
+}
+
+test "checkpoint bounded: rank and epoch domain separate an existing rows identity" {
+    const a: file.Identity = .{ .block = @splat(7), .rank = 1, .epoch = 19 };
+    var b = a;
+    b.rank = 2;
+    var c = a;
+    c.epoch = 20;
+    try t.expect(!std.mem.eql(u8, &a.name(), &b.name()));
+    try t.expect(!std.mem.eql(u8, &a.name(), &c.name()));
+}
diff --git a/zig/src/core/checkpoint_stream.zig b/zig/src/core/checkpoint_stream.zig
new file mode 100644
--- /dev/null
+++ b/zig/src/core/checkpoint_stream.zig
@@ -0,0 +1,140 @@
+//! Caller-owned transfer credits. DMA completion and file-write completion are independent lifetime gates.
+const std = @import("std");
+const capture = @import("checkpoint_capture.zig");
+
+pub const Key = struct { slot: usize, generation: u64 };
+const DMA = enum { pending, good, failed };
+const IO = enum { waiting, pending, done, skipped };
+pub const Slot = struct {
+    generation: u64 = 0,
+    chunk: ?capture.Chunk = null,
+    dma: DMA = .pending,
+    io: IO = .waiting,
+};
+pub const Ticket = struct { key: Key, chunk: capture.Chunk, target: []u8 };
+
+/// Single-owner state machine; workers return tagged completions to that owner, including after cancellation.
+pub const Ring = struct {
+    source: capture.Source,
+    storage: []u8,
+    slots: []Slot,
+    slot_bytes: usize,
+    emitted: u64 = 0,
+    written: u64 = 0,
+    active: usize = 0,
+    stopped: bool = false,
+    closed: bool = false,
+
+    /// Storage must be pinned for an asynchronous CUDA driver; its allocator outlives close().
+    pub fn init(source: capture.Source, storage: []u8, slots: []Slot, slot_bytes: usize) !Ring {
+        if (slots.len == 0 or slot_bytes == 0 or storage.len / slot_bytes < slots.len) return error.InvalidRing;
+        try source.owner.borrow();
+        @memset(slots, .{});
+        return .{ .source = source, .storage = storage, .slots = slots, .slot_bytes = slot_bytes };
+    }
+
+    /// Success hands the driver one credit; even a failed submission must report when its work is drained.
+    pub fn acquire(r: *Ring) !Ticket {
+        if (r.closed) return error.Closed;
+        if (r.stopped) return error.CheckpointStopped;
+        if (r.emitted == r.source.len) return error.EndOfCheckpoint;
+        const i = for (r.slots, 0..) |s, i| {
+            if (s.chunk == null and s.generation < std.math.maxInt(u64)) break i;
+        } else return error.CheckpointBackpressure;
+        const chunk = (r.source.next(r.source.ctx, r.slot_bytes) catch |err| {
+            r.cancel();
+            return err;
+        }) orelse {
+            r.cancel();
+            return error.ShortSource;
+        };
+        if (chunk.len == 0 or chunk.len > r.slot_bytes or chunk.offset != r.emitted or
+            chunk.len > r.source.len - r.emitted)
+        {
+            r.cancel();
+            return error.InvalidChunk;
+        }
+        const valid = switch (chunk.location) {
+            .host => |bytes| bytes.len == chunk.len,
+            .device => |address| address != 0 and address <= std.math.maxInt(u64) - chunk.len,
+        };
+        if (!valid) {
+            r.cancel();
+            return error.InvalidChunk;
+        }
+        const s = &r.slots[i];
+        s.* = .{ .generation = s.generation + 1, .chunk = chunk };
+        r.active += 1;
+        r.emitted += chunk.len;
+        return .{ .key = .{ .slot = i, .generation = s.generation }, .chunk = chunk, .target = r.storage[i * r.slot_bytes ..][0..chunk.len] };
+    }
+
+    fn slot(r: *Ring, key: Key) !*Slot {
+        if (r.closed) return error.Closed;
+        if (key.slot >= r.slots.len) return error.StaleCompletion;
+        const s = &r.slots[key.slot];
+        if (s.chunk == null or s.generation != key.generation) return error.StaleCompletion;
+        return s;
+    }
+
+    pub fn inspect(r: *Ring, key: Key) !capture.Chunk {
+        return (try r.slot(key)).chunk.?;
+    }
+
+    /// Called only after the event completes or the failing stream has drained; submission is not completion.
+    pub fn dmaDone(r: *Ring, key: Key, success: bool) !void {
+        const s = try r.slot(key);
+        if (s.dma != .pending) return error.InvalidTransition;
+        s.dma = if (success) .good else .failed;
+        if (!success) r.cancel();
+    }
+
+    /// A sink can borrow the buffer only after DMA succeeded; its tagged completion ends that borrow.
+    pub fn beginWrite(r: *Ring, key: Key) ![]const u8 {
+        const s = try r.slot(key);
+        if (r.stopped) return error.CheckpointStopped;
+        if (s.dma != .good or s.io != .waiting) return error.InvalidTransition;
+        s.io = .pending;
+        return r.storage[key.slot * r.slot_bytes ..][0..s.chunk.?.len];
+    }
+
+    pub fn ioDone(r: *Ring, key: Key, success: bool) !void {
+        const s = try r.slot(key);
+        if (s.io != .pending) return error.InvalidTransition;
+        s.io = .done;
+        if (success) r.written += s.chunk.?.len else r.cancel();
+    }
+
+    /// Credits return only when both consumers are done. Cancellation never substitutes for either completion.
+    pub fn retire(r: *Ring, key: Key) !void {
+        const s = try r.slot(key);
+        if (s.dma == .pending or (s.io != .done and s.io != .skipped)) return error.CheckpointBusy;
+        s.chunk = null;
+        r.active -= 1;
+    }
+
+    pub fn cancel(r: *Ring) void {
+        if (r.closed) return;
+        r.stopped = true;
+        for (r.slots) |*s| if (s.chunk != null and s.io == .waiting) {
+            s.io = .skipped;
+        };
+    }
+
+    /// Ready for the rank writer's sealing step, not a claim of filesystem or all-rank durability.
+    pub fn readyToSeal(r: *const Ring) bool {
+        return !r.closed and !r.stopped and r.active == 0 and r.written == r.source.len;
+    }
+
+    pub fn close(r: *Ring) !void {
+        if (r.closed) return error.Closed;
+        if (r.active != 0) return error.CheckpointBusy;
+        if (!r.stopped and !r.readyToSeal()) return error.CheckpointBusy;
+        r.source.owner.unborrow();
+        r.closed = true;
+    }
+};
+
+test {
+    _ = @import("checkpoint_stream_test.zig");
+}
