diff --git a/zig/src/cuda/download_stage.zig b/zig/src/cuda/download_stage.zig
new file mode 100644
--- /dev/null
+++ b/zig/src/cuda/download_stage.zig
@@ -0,0 +1,54 @@
+//! A thread's page-locked bounce for synchronous downloads on integrated GPUs.
+const std = @import("std");
+const abi = @import("abi.zig");
+const Driver = @import("driver.zig").Driver;
+const Error = @import("driver.zig").Error;
+const memory = @import("memory.zig");
+
+/// The largest piece one copy takes; larger downloads go through in pieces.
+pub const most: usize = 4 << 20;
+
+const Held = struct { d: *const Driver, bytes: []align(16) u8 };
+const Device = struct { d: *const Driver, integrated: bool };
+threadlocal var held: ?Held = null;
+threadlocal var device: ?Device = null;
+
+/// Whether this thread's current device shares memory with the host; read once per driver.
+pub fn integrated(d: *const Driver) Error!bool {
+    if (device) |one| if (one.d == d) return one.integrated;
+    var dev: abi.Device = 0;
+    try d.check(d.api.cuCtxGetDevice(&dev), "cuCtxGetDevice");
+    var v: c_int = 0;
+    try d.check(d.api.cuDeviceGetAttribute(&v, .integrated, dev), "cuDeviceGetAttribute");
+    device = .{ .d = d, .integrated = v != 0 };
+    return v != 0;
+}
+
+/// This thread's page-locked buffer of at least `len` bytes; it counts in `memory.usage`.
+pub fn take(d: *const Driver, len: usize) Error![]align(16) u8 {
+    if (held) |h| {
+        if (h.d == d and h.bytes.len >= len) return h.bytes[0..len];
+        drop();
+    }
+    const size = @min(most, std.math.ceilPowerOfTwoAssert(usize, @max(len, 64 << 10)));
+    var p: ?*anyopaque = null;
+    try d.check(d.api.cuMemHostAlloc(&p, size, abi.host_alloc_portable), "cuMemHostAlloc");
+    const base: [*]align(16) u8 = @ptrCast(@alignCast(p.?));
+    held = .{ .d = d, .bytes = base[0..size] };
+    memory.retainHost(size);
+    return held.?.bytes[0..len];
+}
+
+/// Frees this thread's buffer, if one is held.
+pub fn drop() void {
+    if (held) |h| {
+        _ = h.d.api.cuMemFreeHost(h.bytes.ptr);
+        memory.releaseRetainedHost(h.bytes.len);
+        held = null;
+    }
+}
+
+/// Forgets the cached device reading (tests use distinct drivers, but a fake may reuse one).
+pub fn forget() void {
+    device = null;
+}
diff --git a/zig/src/cuda/download_stage_test.zig b/zig/src/cuda/download_stage_test.zig
new file mode 100644
--- /dev/null
+++ b/zig/src/cuda/download_stage_test.zig
@@ -0,0 +1,88 @@
+//! The download staging path, with a fake driver that writes only pinned destinations.
+const std = @import("std");
+const abi = @import("abi.zig");
+const Driver = @import("driver.zig").Driver;
+const memory = @import("memory.zig");
+const stage = @import("download_stage.zig");
+
+var pinned: [64 << 10]u8 align(16) = undefined;
+var destination: usize = 0;
+var allocations: usize = 0;
+var integrated_flag: c_int = 1;
+
+fn pinnedRange(ptr: usize) bool {
+    const base = @intFromPtr(&pinned[0]);
+    return ptr >= base and ptr < base + pinned.len;
+}
+
+fn hostAlloc(out: ?*?*anyopaque, len: usize, _: c_uint) callconv(.c) abi.Result {
+    if (len > pinned.len) return 1;
+    allocations += 1;
+    out.?.* = &pinned[0];
+    return 0;
+}
+
+fn hostFree(_: ?*anyopaque) callconv(.c) abi.Result {
+    return 0;
+}
+
+fn contextDevice(out: *abi.Device) callconv(.c) abi.Result {
+    out.* = 0;
+    return 0;
+}
+
+fn deviceAttribute(out: *c_int, attribute: abi.DeviceAttribute, _: abi.Device) callconv(.c) abi.Result {
+    out.* = if (attribute == .integrated) integrated_flag else 0;
+    return 0;
+}
+
+fn copyToHost(dst: ?*anyopaque, _: abi.DevicePtr, len: usize) callconv(.c) abi.Result {
+    destination = @intFromPtr(dst.?);
+    if (pinnedRange(destination) or integrated_flag == 0) @memset(@as([*]u8, @ptrCast(dst.?))[0..len], 0x5a);
+    return 0;
+}
+
+fn driver() Driver {
+    var d: Driver = undefined;
+    d.api.cuMemHostAlloc = hostAlloc;
+    d.api.cuMemFreeHost = hostFree;
+    d.api.cuCtxGetDevice = contextDevice;
+    d.api.cuDeviceGetAttribute = deviceAttribute;
+    d.api.cuMemcpyDtoH_v2 = copyToHost;
+    return d;
+}
+
+test "an integrated GPU's download lands in pinned memory, not the caller's pageable slice" {
+    integrated_flag = 1;
+    allocations = 0;
+    stage.forget();
+    stage.drop();
+    defer stage.forget();
+    defer stage.drop();
+    const before = memory.usage(false).host;
+    var d = driver();
+    var out: [64]u8 = @splat(0xaa);
+    const src: memory.DeviceBuffer = .{ .d = &d, .ptr = 0x1000, .len = out.len, .borrowed = true };
+    try src.download(0, &out);
+    try std.testing.expect(std.mem.allEqual(u8, &out, 0x5a));
+    try std.testing.expect(pinnedRange(destination));
+    try std.testing.expect(destination != @intFromPtr(&out));
+    try std.testing.expectEqual(@as(usize, 1), allocations);
+    try std.testing.expect(memory.usage(false).host >= before + (64 << 10));
+}
+
+test "a discrete GPU's download copies straight into the caller's slice" {
+    integrated_flag = 0;
+    allocations = 0;
+    stage.forget();
+    stage.drop();
+    defer stage.forget();
+    defer stage.drop();
+    var d = driver();
+    var out: [64]u8 = @splat(0xaa);
+    const src: memory.DeviceBuffer = .{ .d = &d, .ptr = 0x1000, .len = out.len, .borrowed = true };
+    try src.download(0, &out);
+    try std.testing.expect(std.mem.allEqual(u8, &out, 0x5a));
+    try std.testing.expectEqual(@intFromPtr(&out), destination);
+    try std.testing.expectEqual(@as(usize, 0), allocations);
+}
