+/// The score launch uses the visible key count with the production power-of-two destination pitch.
+fn scoreVerifyRange(pos: usize, rows: usize, extended: bool) bool {
+    if (rows < 2 or rows > 16) return false;
+    if (pos >= 40960) return true;
+    if (!extended) return false;
+    // Each width retains its existing path below its measured crossover on GB10.
+    const floor: usize = switch (rows) {
+        2 => 16384,
+        3, 4, 5, 6 => 8192,
+        8 => 4096,
+        12, 16 => 2048,
+        else => return false,
+    };
+    return pos >= floor;
+}
