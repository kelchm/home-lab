diff --git a/zig/src/server/literal_tokens_test.zig b/zig/src/server/literal_tokens_test.zig
index 47eb963..3e65cd9 100644
--- a/zig/src/server/literal_tokens_test.zig
+++ b/zig/src/server/literal_tokens_test.zig
@@ -192,3 +192,23 @@ test "hide copies only what changes and leaves the caller's value alone" {
     try testing.expectEqualStrings("<think>", quoted.array[0].strField("content").?);
     try testing.expectEqualStrings("\u{E005}", hidden.array[0].strField("content").?);
 }
+
+test "a quoted think tag in an object key, a tool's parameter or an argument's name, stays text" {
+    var arena = std.heap.ArenaAllocator.init(testing.allocator);
+    defer arena.deinit();
+    const a = arena.allocator();
+    const t = try literal_tokens.Table.init(a, &added);
+    const properties = try json.newObject(a);
+    try properties.put(a, "</think>", .{ .string = "plain" });
+    try properties.put(a, "city", .{ .string = "Oslo" });
+    const schema = try json.newObject(a);
+    try schema.put(a, "properties", .{ .object = properties });
+    try testing.expect(t.needs(.{ .object = schema }));
+    const hidden = (try t.hide(a, .{ .object = schema })).object.get("properties").?.object;
+    try testing.expect(hidden.get("</think>") == null);
+    try testing.expectEqualStrings("plain", hidden.values()[0].string);
+    try testing.expect(std.mem.indexOf(u8, hidden.keys()[0], "think") == null);
+    try testing.expectEqualStrings("Oslo", hidden.get("city").?.string);
+    // the caller's value keeps its key
+    try testing.expect(properties.get("</think>") != null);
+}
