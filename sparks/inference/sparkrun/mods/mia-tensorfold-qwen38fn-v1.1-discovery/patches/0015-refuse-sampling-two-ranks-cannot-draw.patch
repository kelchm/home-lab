     /// The call gate and grammar a request asks for, or its refusal when the engine cannot enforce them.
@@ -316,3 +321,22 @@ fn lateSystem(a: Allocator, text: model_text.Text) ![]const u8 {
 fn needsUserAfterTool(source: []const u8) bool {
     return std.mem.indexOf(u8, source, "No user query found") != null;
 }
+
+/// Top_k off with neither a top_p cut nor min_p: every draw then exchanges each rank's whole vocabulary shard
+/// (cuda_nucleus.sampleRows), and at two ranks the draft head's draws on that path exit both ranks
+/// (MiaAI-Lab/Qwen3.8-Flash-Dual-DGX-Sparks-TensorFold#8).
+fn wholeVocabulary(s: api.Sampling) bool {
+    return s.temperature > 0 and s.top_k == 0 and !(0 < s.top_p and s.top_p < 1) and s.min_p <= 0;
+}
+
+/// The largest top_k two ranks draw from: the TP sampler's scratch holds 256 candidates (flashnext cuda_engine.max_k)
+/// and a draw reads top_k plus 8 (cuda_sampler.margin); more fails after admission (TopKPastScratch) and exits both.
+const ranks_top_k = 248;
+
+test "sampling that draws from the whole vocabulary is refused, and any cut is served" {
+    try std.testing.expect(wholeVocabulary(.{ .seed = 1, .temperature = 1, .top_k = 0, .top_p = 1, .min_p = 0 }));
+    try std.testing.expect(wholeVocabulary(.{ .seed = 1, .temperature = 0.7, .top_k = 0, .top_p = 0, .min_p = 0 }));
+    try std.testing.expect(!wholeVocabulary(.{ .seed = 1, .temperature = 1, .top_k = 20, .top_p = 1, .min_p = 0 }));
+    try std.testing.expect(!wholeVocabulary(.{ .seed = 1, .temperature = 1, .top_k = 0, .top_p = 0.95, .min_p = 0 }));
+    try std.testing.expect(!wholeVocabulary(.{ .seed = 1, .temperature = 1, .top_k = 0, .top_p = 1, .min_p = 0.05 }));
+}
