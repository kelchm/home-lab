+
+test "two ranks refuse a request that would draw from the whole vocabulary; one rank, or a top_k, is served" {
+    const whole = "{\"model\":\"test-model\",\"messages\":[{\"role\":\"user\",\"content\":\"x\"}],\"max_tokens\":2,\"temperature\":0.7,\"top_k\":-1,\"top_p\":1}";
+    const two = try sendTo(.chat, whole, .{ .ranks = 2 });
+    try std.testing.expectEqual(@as(?u16, 400), two.status);
+    try std.testing.expectEqual(@as(i64, 0), two.preparing);
+    try std.testing.expectEqual(@as(?u16, 200), (try send(.chat, whole)).status);
+    const cut = "{\"model\":\"test-model\",\"messages\":[{\"role\":\"user\",\"content\":\"x\"}],\"max_tokens\":2,\"temperature\":0.7,\"top_k\":20,\"top_p\":1}";
+    try std.testing.expectEqual(@as(?u16, 200), (try sendTo(.chat, cut, .{ .ranks = 2 })).status);
+}
+
+test "two ranks refuse a top_k past their 248 candidates and serve 248" {
+    const past = "{\"model\":\"test-model\",\"messages\":[{\"role\":\"user\",\"content\":\"x\"}],\"max_tokens\":2,\"temperature\":1,\"top_k\":249,\"top_p\":0.95}";
+    const two = try sendTo(.chat, past, .{ .ranks = 2 });
+    try std.testing.expectEqual(@as(?u16, 400), two.status);
+    try std.testing.expectEqual(@as(i64, 0), two.preparing);
+    try std.testing.expectEqual(@as(?u16, 200), (try send(.chat, past)).status);
+    const most = "{\"model\":\"test-model\",\"messages\":[{\"role\":\"user\",\"content\":\"x\"}],\"max_tokens\":2,\"temperature\":1,\"top_k\":248,\"top_p\":0.95}";
+    try std.testing.expectEqual(@as(?u16, 200), (try sendTo(.chat, most, .{ .ranks = 2 })).status);
+    const greedy = "{\"model\":\"test-model\",\"messages\":[{\"role\":\"user\",\"content\":\"x\"}],\"max_tokens\":2,\"temperature\":0,\"top_k\":1000}";
+    try std.testing.expectEqual(@as(?u16, 200), (try sendTo(.chat, greedy, .{ .ranks = 2 })).status);
+}
