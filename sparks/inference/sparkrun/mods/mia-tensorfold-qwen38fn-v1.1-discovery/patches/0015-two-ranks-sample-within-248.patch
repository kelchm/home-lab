+test "a flat row drawn at top_k 248 stays within its 248 best candidates for any top_p" {
+    const gpa = std.testing.allocator;
+    var values: [512]f64 = undefined;
+    var ids: [512]u64 = undefined;
+    for (&values, &ids, 0..) |*v, *id, i| {
+        v.* = 0.0;
+        id.* = 511 - i; // ties keep the lowest ids
+    }
+    for ([_]f64{ 0.95, 1.0 }) |top_p| for (0..64) |position| {
+        const token = try choose(gpa, &values, &ids, position, .{ .seed = 7, .temperature = 1.5, .top_k = 248, .top_p = top_p });
+        try std.testing.expect(token < 248);
+    };
+}
