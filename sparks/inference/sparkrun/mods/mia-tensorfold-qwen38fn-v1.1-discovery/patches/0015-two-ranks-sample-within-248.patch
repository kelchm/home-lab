@@ -316,3 +320,28 @@ fn lateSystem(a: Allocator, text: model_text.Text) ![]const u8 {
 fn needsUserAfterTool(source: []const u8) bool {
     return std.mem.indexOf(u8, source, "No user query found") != null;
 }
+
+/// The largest top_k two ranks draw from: the TP sampler's scratch holds 256 candidates (flashnext cuda_engine.max_k)
+/// and a draw reads top_k plus 8 (cuda_sampler.margin); more fails after admission (TopKPastScratch) and exits both.
+const ranks_top_k = 248;
+
+/// A sampled request as two ranks can draw it, or null when they cannot. Top_k off becomes 248, with top_p and min_p
+/// still cutting within it: off, a draw goes through the nucleus exchange, whose whole-shard fallback for a nucleus
+/// past 1,024 candidates a rank exits both ranks (MiaAI-Lab/Qwen3.8-Flash-Dual-DGX-Sparks-TensorFold#8).
+fn forRanks(s: api.Sampling) ?api.Sampling {
+    if (s.top_k > ranks_top_k) return null;
+    var out = s;
+    if (out.top_k == 0) out.top_k = ranks_top_k;
+    return out;
+}
+
+test "two ranks draw top_k off from 248 candidates, keep the other cuts, and refuse more than 248" {
+    const off = forRanks(.{ .seed = 1, .temperature = 1.5, .top_k = 0, .top_p = 0.95, .min_p = 0.02 }).?;
+    try std.testing.expectEqual(@as(u32, 248), off.top_k);
+    try std.testing.expectEqual(@as(f64, 0.95), off.top_p);
+    try std.testing.expectEqual(@as(f64, 0.02), off.min_p);
+    try std.testing.expectEqual(@as(f64, 1.5), off.temperature);
+    try std.testing.expectEqual(@as(u32, 20), forRanks(.{ .seed = 1, .top_k = 20 }).?.top_k);
+    try std.testing.expectEqual(@as(u32, 248), forRanks(.{ .seed = 1, .top_k = 248 }).?.top_k);
+    try std.testing.expect(forRanks(.{ .seed = 1, .top_k = 249 }) == null);
+}
