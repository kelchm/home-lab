# Site overrides for the DSpark guide's .env.dspark.
#
# Upstream: github.com/tonyd2wild/DeepSeek-v4-Flash-0731-DSpark-1M-NVFP4-KV-2x-DGX-Spark
# Everything not listed here keeps the guide's default. Copy the guide's
# .env.dspark.example, then apply these.
#
# Fabric addresses, not LAN: NCCL and the torch.distributed rendezvous both run
# over the ConnectX-7 link. Confirm NET/IB appears in the logs - NET/Socket means
# it silently fell back to 10GbE.

WORKER_HOST=10.32.21.32
WORKER_DIR=/home/kelchm/dspark-guide
WORKER_SCRIPT_DIR=/home/kelchm/dspark-guide
MASTER_ADDR=198.19.240.11
MASTER_PORT=25000
NCCL_IB_HCA=rocep1s0f0,roceP2p1s0f0
NCCL_SOCKET_IFNAME=enp1s0f0np0,enP2p1s0f0np0
HF_CACHE=/opt/spark-models
WORKER_HF_CACHE=/opt/spark-models
DSPARK_MODEL=deepseek-ai/DeepSeek-V4-Flash-0731
VLLM_HOST_IP=198.19.240.11
WORKER_VLLM_HOST_IP=198.19.240.12
