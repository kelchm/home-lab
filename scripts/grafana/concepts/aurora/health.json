 "id": null,
 "liveNow": false,
 "schemaVersion": 40,
 "timezone": "browser",
 "uid": "concept-aurora-health",
 "title": "Concept · Aurora · Sparks",
 "description": "GPU, heat, memory and interconnect health for the Spark machines, so a slow or failing model can be traced to its cause. Shared CPU/GPU memory usage is host memory usage, not GPU allocation.",
 "editable": true,
 "version": 0,
 "refresh": "30s",
 "time": {
  "from": "now-1h",
  "to": "now"
 },
 "tags": [
  "concept"
 ],
 "links": [],
 "panels": [
  {
   "id": 1,
   "type": "stat",
   "title": "",
   "description": "Memory left. Orange is under 4 GiB and red is under the 2 GiB stop line.",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 6,
    "h": 5
   },
   "fieldConfig": {
    "defaults": {
     "color": {
      "mode": "thresholds"
     },
     "unit": "bytes",
     "decimals": 1,
     "noValue": "–",
     "mappings": [],
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "#FB7185",
        "value": null
       },
       {
        "color": "#FBBF24",
        "value": 2147483648
       },
       {
        "color": "#2DD4BF",
        "value": 4294967296
       }
      ]
     },
     "displayName": "Memory · ${__field.labels.instance}",
     "min": 0,
     "max": 17200000000.0
    },
    "overrides": []
   },
   "options": {
    "colorMode": "none",
    "graphMode": "area",
    "justifyMode": "auto",
    "orientation": "auto",
    "percentChangeColorMode": "standard",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "showPercentChange": false,
    "text": {
     "titleSize": 13,
     "valueSize": 26
    },
    "textMode": "value_and_name",
    "wideLayout": true
   },
   "interval": "15s",
   "maxDataPoints": 60,
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "editorMode": "code",
     "expr": "node_memory_MemAvailable_bytes{job=\"spark-node\",platform=\"spark\",instance=~\"$node\"}",
     "legendFormat": "{{instance}}",
     "refId": "A",
     "range": true,
     "instant": false,
     "interval": "15s"
    }
   ]
  },
  {
   "id": 2,
   "type": "stat",
   "title": "",
   "description": "The hotter of the board and the GPU. The board's critical trip point is 104.8 °C; orange is the 95 °C it reaches under heavy load and red is the 99.8 °C alert.",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "x": 6,
    "y": 0,
    "w": 6,
    "h": 5
   },
   "fieldConfig": {
    "defaults": {
     "color": {
      "mode": "thresholds"
     },
     "unit": "celsius",
     "decimals": 0,
     "noValue": "–",
     "mappings": [],
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "#F472B6",
        "value": null
       },
       {
        "color": "#FBBF24",
        "value": 95
       },
       {
        "color": "#FB7185",
        "value": 99.8
       }
      ]
     },
     "displayName": "Hottest · ${__field.labels.instance}",
     "min": 30,
     "max": 165
    },
    "overrides": []
   },
   "options": {
    "colorMode": "none",
    "graphMode": "area",
    "justifyMode": "auto",
    "orientation": "auto",
    "percentChangeColorMode": "standard",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "showPercentChange": false,
    "text": {
     "titleSize": 13,
     "valueSize": 26
    },
    "textMode": "value_and_name",
    "wideLayout": true
   },
   "interval": "15s",
   "maxDataPoints": 60,
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "editorMode": "code",
     "expr": "max by (instance) (label_set(max by (instance) (max_over_time(node_thermal_zone_temp{job=\"spark-node\",platform=\"spark\",instance=~\"$node\"}[$__rate_interval])), \"source\", \"board\") or label_set(max by (instance) (max_over_time(nvidia_smi_temperature_gpu{job=\"spark-gpu\",platform=\"spark\",instance=~\"$node\"}[$__rate_interval])), \"source\", \"gpu\"))",
     "legendFormat": "{{instance}}",
     "refId": "A",
     "range": true,
     "instant": false,
     "interval": "15s"
    }
   ]
  },
  {
   "id": 3,
   "type": "stat",
   "title": "",
   "description": "The fullest persistent filesystem on each Spark. The low-space alert fires at 90%.",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 4,
    "h": 5
   },
   "fieldConfig": {
    "defaults": {
     "color": {
      "mode": "thresholds"
     },
     "unit": "percentunit",
     "decimals": 0,
     "noValue": "–",
     "mappings": [],
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "text",
        "value": null
       },
       {
        "color": "#FBBF24",
        "value": 0.8
       },
       {
        "color": "#FB7185",
        "value": 0.9
       }
      ]
     },
     "displayName": "Disk · ${__field.labels.instance}"
    },
    "overrides": []
   },
   "options": {
    "colorMode": "value",
    "graphMode": "none",
    "justifyMode": "auto",
    "orientation": "auto",
    "percentChangeColorMode": "standard",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "showPercentChange": false,
    "text": {
     "titleSize": 13,
     "valueSize": 26
    },
    "textMode": "value_and_name",
    "wideLayout": true
   },
   "interval": "15s",
   "maxDataPoints": 60,
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "editorMode": "code",
     "expr": "max by (instance) (1 - node_filesystem_avail_bytes{job=\"spark-node\",platform=\"spark\",instance=~\"$node\",mountpoint!=\"/boot/efi\",fstype!~\"tmpfs|overlay|squashfs|ramfs|efivarfs|nfs.*|cifs|fuse.*\"} / node_filesystem_size_bytes{job=\"spark-node\",platform=\"spark\",instance=~\"$node\",mountpoint!=\"/boot/efi\",fstype!~\"tmpfs|overlay|squashfs|ramfs|efivarfs|nfs.*|cifs|fuse.*\"})",
     "legendFormat": "{{instance}}",
     "refId": "A",
     "range": true,
     "instant": false,
     "interval": "15s"
    }
   ]
  },
  {
   "id": 4,
