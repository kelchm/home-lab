     "editorMode": "code",
     "expr": "sum(increase({__name__=~\"node_infiniband_(link_downed|local_ack_timeout_errors|out_of_sequence_packets_received|packet_sequence_errors|port_errors_received|roce_adp_retransmits)_total\",job=\"spark-node\",platform=\"spark\",instance=~\"$node\",device=~\".*s0f0\"}[1h]))",
     "legendFormat": "",
