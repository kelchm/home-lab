{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "config:recommended",
    "docker:enableMajor",
    "helpers:pinGitHubActionDigests",
    ":automergeBranch",
    ":dependencyDashboard",
    ":disableRateLimiting",
    ":semanticCommits",
  ],
  dependencyDashboard: true,
  dependencyDashboardTitle: "Renovate Dashboard :robot:",
  schedule: ["every weekend"],
  // A held or disabled minor update would otherwise also hide the patch
  // releases of the version in use.
  separateMinorPatch: true,
  ignorePaths: ["**/*.sops.*"],
  flux: {
    managerFilePatterns: ["/(^|/)kubernetes/.+\\.ya?ml$/"],
  },
  helmfile: {
    managerFilePatterns: [
      "/(^|/)helmfile\\.ya?ml(?:\\.gotmpl)?$/",
      "/(^|/)helmfile\\.d/.+\\.ya?ml(?:\\.gotmpl)?$/",
    ],
  },
  kubernetes: {
    managerFilePatterns: ["/(^|/)kubernetes/.+\\.ya?ml$/"],
  },
  kustomize: {
    managerFilePatterns: ["/^kustomization\\.ya?ml$/"],
  },
  packageRules: [
    {
      description: "CNI and device plugin: pin images and review all updates",
      matchFileNames: ["kubernetes/apps/kube-system/{multus,whereabouts,generic-device-plugin}/app/kustomization.yaml"],
      matchManagers: ["kustomize", "custom.regex"],
      pinDigests: true,
      automerge: false,
    },
    {
      // Source tags resolve to commit digests; Kustomize owns image digests.
      // Group release changes only: same-release digest refreshes can be reviewed independently.
      description: "Multus: update the source release and thick image together",
      matchFileNames: ["kubernetes/apps/kube-system/multus/app/kustomization.yaml"],
      matchManagers: ["kustomize", "custom.regex"],
      matchUpdateTypes: ["major", "minor", "patch"],
      groupName: "Multus release",
      minimumGroupSize: 2,
    },
    {
      description: "Whereabouts: update four manifest references and the image together",
      matchFileNames: ["kubernetes/apps/kube-system/whereabouts/app/kustomization.yaml"],
      matchManagers: ["kustomize", "custom.regex"],
      matchUpdateTypes: ["major", "minor", "patch"],
      groupName: "Whereabouts release",
      minimumGroupSize: 5,
    },
    {
      description: "Generic device plugin: update the runtime source and image together",
      matchFileNames: ["kubernetes/apps/kube-system/generic-device-plugin/app/kustomization.yaml"],
      matchManagers: ["kustomize", "custom.regex"],
      matchUpdateTypes: ["major", "minor", "patch"],
      groupName: "Generic device plugin release",
      minimumGroupSize: 2,
    },
    {
      // A core release changes both payloads. Digest refreshes at the same
      // release can safely land independently; qualification checks the releases.
      description: "Hermes Caddy: update builder and runtime core releases together",
      matchManagers: ["dockerfile"],
      matchFileNames: ["proxmox/guests/hermes-1/Dockerfile.caddy"],
      matchPackageNames: ["caddy"],
      matchUpdateTypes: ["major", "minor", "patch"],
      groupName: "Hermes Caddy core",
      minimumGroupSize: 2,
    },
    {
      // A digest-only FROM declares exact content without a tag to follow.
      // Do not guess latest. Tagged references in the same file stay managed.
      // Lock rationale and review process: docs/runbooks/dependency-updates.md.
      description: "Dockerfile images: leave digest-only pins unchanged",
      matchManagers: ["dockerfile"],
      matchDatasources: ["docker"],
      matchJsonata: [
        "currentDigest and ($not($exists(currentValue)) or currentValue = null or currentValue = '')",
      ],
      enabled: false,
    },
    {
      // CI must test the SparkRun version recorded for the host venv.
      // Review upgrades with the host installation, adapter version notes,
      // and the SparkRun and repository-validation documentation together.
      description: "SparkRun test SDK: coordinate upgrades with the Sparks",
      matchManagers: ["pip_requirements"],
      matchDatasources: ["pypi"],
      matchFileNames: ["sparks/inference/sparkrun/requirements-test.txt"],
      matchPackageNames: ["sparkrun"],
      automerge: false,
      dependencyDashboardApproval: true,
    },
    {
      // external-dns v0.22.0 (chart 1.22.0) changed the default annotation
      // prefix with no fallback; the first `policy: sync` pass then deleted
      // every managed record in the zone (2026-09-19 incident). Any future
      // bump must be reviewed against the external-dns upgrade playbook and
      // rolled out with a dry-run gate, never unattended.
      description: "external-dns: DNS-mutating, require manual dashboard approval",
      matchPackageNames: ["ghcr.io/home-operations/charts-mirror/external-dns"],
      automerge: false,
      dependencyDashboardApproval: true,
    },
    {
      description: "Grafana catalog plugins: require reviewed upgrades",
      matchDatasources: ["custom.grafana-plugins"],
      automerge: false,
      semanticCommitScope: "grafana-plugin",
      commitMessageTopic: "plugin {{depName}}",
    },
    {
      // VSS 7.7.0 introduced mandatory server licensing. Keep the proven
      // pre-license deployment byte-for-byte pinned unless this rule and the
      // image pins are deliberately changed together.
      description: "Visionect VSS: freeze the deployed pre-license image",
      matchDatasources: ["docker"],
      matchPackageNames: ["docker.io/visionect/visionect-server-v3"],
      enabled: false,
    },
    {
      // VSS 7.6.5 is a frozen vendor binary; its Redis client is not
      // inspectable. Valkey 7.2 reports redis_version 7.2.4, which that client
      // already supports. Patches still flow; 8.x and 9.x do not.
      description: "Valkey: cap the VSS cache sidecar at the 7.x series",
      matchDatasources: ["docker"],
      matchPackageNames: ["docker.io/valkey/valkey"],
      allowedVersions: "<8.0.0",
    },
    {
      // apt-metrics reads the host's apt and dpkg state, so its image must match
      // the Sparks' Ubuntu release (DGX OS 7 is 24.04). Digest refreshes still
      // flow. Revisit when the Sparks move to a new Ubuntu release, or when a
      // different image release is qualified against the host's apt state.
      description: "Spark apt helpers: hold the image at the hosts' Ubuntu release",
      matchDatasources: ["docker"],
      matchFileNames: ["sparks/monitoring/compose.yaml"],
      matchPackageNames: ["docker.io/library/ubuntu"],
      allowedVersions: "/^24\\.04$/",
    },
    {
      // Kaniop rejects kanidm server minors newer than its bundled client SDK.
      // Ceiling value is machine-managed by the "Kanidm Ceiling Sync" workflow.
      description: "kanidm/server: cap at the minor supported by kaniop's SDK",
      matchDatasources: ["docker"],
      matchPackageNames: ["/kanidm/server$/"],
      allowedVersions: "<1.12.0",
    },
    {
      // Docker versioning reads "nbxyz24" as a suffix, and a different suffix
      // as a different variant, so new builds of one release never match.
      description: "netboot.xyz: compare the nbxyz build number as a version part",
      matchDatasources: ["docker"],
      matchPackageNames: ["ghcr.io/netbootxyz/netbootxyz"],
      versioning: "regex:^(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)-nbxyz(?<build>\\d+)$",
    },
    {
      // pcbparts-mcp publishes only main-<sha>-<YYYYMMDD> build tags.
      description: "pcbparts-mcp: order main builds by their tag date",
      matchDatasources: ["docker"],
      matchPackageNames: ["ghcr.io/averyy/pcbparts-mcp"],
      versioning: "regex:^main-[0-9a-f]+-(?<major>\\d{4})(?<minor>\\d{2})(?<patch>\\d{2})$",
    },
    {
      // Renovate's mise manager strips only a leading "v" from aqua tool
      // tags; these projects prefix their release tags with the tool name.
      description: "mise aqua tools: strip tool-name tag prefixes",
      matchManagers: ["mise"],
      matchPackageNames: ["jqlang/jq", "kubernetes-sigs/kustomize", "lycheeverse/lychee"],
      extractVersion: "^(?:jq-|kustomize/v|lychee-v)(?<version>\\d.*)$",
    },
    {
      // Talos supports only a bounded range of Kubernetes minors. Let patch
      // releases flow, but pair minor and major Kubernetes bumps with the
      // compatible Talos upgrade and its guarded manual rollout.
      description: "Talos Kubernetes: require coordinated minor upgrades",
      matchDatasources: ["docker"],
      matchPackageNames: ["ghcr.io/siderolabs/kubelet"],
      matchUpdateTypes: ["major", "minor"],
      enabled: false,
    },
    {
      // A PostgreSQL major upgrade is a data migration, not an image bump.
      description: "CloudNativePG PostgreSQL: offer minor releases only",
      matchDatasources: ["docker"],
      matchPackageNames: ["ghcr.io/cloudnative-pg/postgresql"],
      matchUpdateTypes: ["major"],
      enabled: false,
    },
    {
      description: "Override Helmfile Dependency Name",
      matchDatasources: ["docker"],
      matchManagers: ["helmfile"],
      overrideDepName: "{{packageName}}",
    },
    {
      description: "Flux Operator Group",
      groupName: "flux-operator",
      matchDatasources: ["docker"],
      matchPackageNames: ["/flux-operator/", "/flux-instance/", "/flux-operator-manifests/"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      minimumGroupSize: 3,
    },
    {
      description: "Auto-merge GitHub Actions",
      matchManagers: ["github-actions"],
      automerge: true,
      automergeType: "branch",
      matchUpdateTypes: ["minor", "patch", "digest"],
      minimumReleaseAge: "3 days",
      ignoreTests: true,
    },
    {
      // The workflow test imports Renovate internals; check compatibility before a bump lands.
      description: "Renovate CI image: test before merging",
      matchManagers: ["github-actions"],
      matchDatasources: ["docker"],
      matchFileNames: [".github/workflows/repository-validation.yaml"],
      matchPackageNames: ["ghcr.io/renovatebot/renovate"],
      automergeType: "pr",
      ignoreTests: false,
    },
    {
      // The render action and inline diff command must use one reviewed image.
      // Override the GitHub Actions auto-merge policy for both managers.
      description: "Flate CI: update render and diff together",
      matchManagers: ["github-actions", "custom.regex"],
      matchDatasources: ["docker"],
      matchFileNames: [".github/workflows/repository-validation.yaml"],
      matchPackageNames: ["ghcr.io/home-operations/flate"],
      groupName: "Flate CI image",
      minimumGroupSize: 2,
      minimumReleaseAge: "3 days",
      automerge: false,
      ignoreTests: false,
    },
    {
      matchUpdateTypes: ["major"],
      semanticCommitType: "feat",
      commitMessagePrefix: "{{semanticCommitType}}({{semanticCommitScope}})!:",
      commitMessageExtra: "( {{currentVersion}} ➔ {{newVersion}} )",
    },
    {
      matchUpdateTypes: ["minor"],
      semanticCommitType: "feat",
      commitMessageExtra: "( {{currentVersion}} ➔ {{newVersion}} )",
    },
    {
      matchUpdateTypes: ["patch"],
      semanticCommitType: "fix",
      commitMessageExtra: "( {{currentVersion}} ➔ {{newVersion}} )",
    },
    {
      matchUpdateTypes: ["digest"],
      semanticCommitType: "chore",
      commitMessageExtra: "( {{currentDigestShort}} ➔ {{newDigestShort}} )",
    },
    {
      matchDatasources: ["docker"],
      semanticCommitScope: "container",
      commitMessageTopic: "image {{depName}}",
    },
    {
      matchDatasources: ["helm"],
      semanticCommitScope: "helm",
      commitMessageTopic: "chart {{depName}}",
    },
    {
      matchManagers: ["github-actions"],
      semanticCommitType: "ci",
      semanticCommitScope: "github-action",
      commitMessageTopic: "action {{depName}}",
    },
    {
      matchDatasources: ["github-releases"],
      semanticCommitScope: "github-release",
      commitMessageTopic: "release {{depName}}",
    },
    {
      matchManagers: ["mise"],
      semanticCommitScope: "mise",
      commitMessageTopic: "tool {{depName}}",
    },
    {
      matchUpdateTypes: ["major"],
      labels: ["type/major"],
    },
    {
      matchUpdateTypes: ["minor"],
      labels: ["type/minor"],
    },
    {
      matchUpdateTypes: ["patch"],
      labels: ["type/patch"],
    },
    {
      matchUpdateTypes: ["digest"],
      labels: ["type/digest"],
    },
    {
      matchDatasources: ["docker"],
      addLabels: ["renovate/container"],
    },
    {
      matchDatasources: ["helm"],
      addLabels: ["renovate/helm"],
    },
    {
      matchManagers: ["github-actions"],
      addLabels: ["renovate/github-action"],
    },
    {
      matchDatasources: ["github-releases"],
      addLabels: ["renovate/github-release"],
    },
  ],
  customDatasources: {
    "grafana-plugins": {
      defaultRegistryUrlTemplate: "https://grafana.com/api/plugins/{{packageName}}/versions",
      format: "json",
      transformTemplates: [
        '{"releases": [items[status = "active"].{"version": version, "releaseTimestamp": createdAt, "sourceUrl": url}], "homepage": "https://grafana.com/grafana/plugins/{{packageName}}/"}',
      ],
    },
  },
  customManagers: [
    {
      description: "Track release-tagged CNI manifests by immutable source commit",
      customType: "regex",
      managerFilePatterns: ["/^kubernetes/apps/kube-system/(multus|whereabouts|generic-device-plugin)/app/kustomization\\.yaml$/"],
      matchStrings: [
        "# renovate: cni-source=(?<depName>\\S+) tag=(?<currentValue>\\S+)\\n  - https://raw\\.githubusercontent\\.com/[^/]+/[^/]+/(?<currentDigest>[a-f0-9]{40})/[^\\s]+",
      ],
      datasourceTemplate: "github-tags",
      versioningTemplate: "semver",
    },
    {
      description: "Track the Hermes Caddy Cloudflare build input",
      customType: "regex",
      managerFilePatterns: ["/^proxmox/guests/hermes-1/Dockerfile\\.caddy$/"],
      matchStrings: [
        "# renovate: datasource=go depName=(?<depName>github\\.com/caddy-dns/cloudflare)\\nARG CLOUDFLARE_VERSION=(?<currentValue>v\\d+\\.\\d+\\.\\d+)\\n",
      ],
      datasourceTemplate: "go",
    },
    {
      description: "Track inline workflow images",
      customType: "regex",
      managerFilePatterns: ["/^\\.github/workflows/[^/]+\\.ya?ml$/"],
      // A tagged, digest-pinned image on its own line in a folded or literal
      // docker run command. Leave uses: docker:// to the native manager.
      matchStrings: [
        "(?:^|\\n)[ \\t]+(?<depName>[a-z0-9.-]+(?::[0-9]+)?/[a-z0-9._/-]+):(?<currentValue>[^\\s\"'@]+)@(?<currentDigest>sha256:[a-f0-9]{64})(?:[ \\t]+\\\\)?[ \\t]*(?:\\r?\\n|$)",
      ],
      datasourceTemplate: "docker",
    },
    {
      description: "Process annotated dependencies",
      customType: "regex",
      managerFilePatterns: [
        "/(^|/).+\\.env$/",
        "/(^|/).+\\.sh$/",
        "/(^|/).+\\.ya?ml$/",
      ],
      matchStrings: [
        // # renovate: datasource=github-releases depName=k3s-io/k3s
        // k3s_release_version: &version v1.29.0+k3s1
        // # renovate: datasource=helm depName=cilium repository=https://helm.cilium.io
        // version: 1.15.1
        // # renovate: datasource=docker depName=ghcr.io/siderolabs/kubelet
        // KUBERNETES_VERSION=v1.31.1
        "datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)( repository=(?<registryUrl>\\S+))?\\n.+(:\\s|=)(&\\S+\\s)?(?<currentValue>\\S+)",
        // # renovate: datasource=docker depName=ghcr.io/prometheus-operator/prometheus-operator
        // https://raw.githubusercontent.com/prometheus-operator/prometheus-operator/v0.80.0/example/prometheus-operator-crd/monitoring.coreos.com_alertmanagerconfigs.yaml
        "datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\n.+/(?<currentValue>(v|\\d)[^/]+)",
      ],
      datasourceTemplate: "{{#if datasource}}{{{datasource}}}{{else}}github-releases{{/if}}",
    },
    {
      description: "Track URL-pinned Grafana catalog plugins",
      customType: "regex",
      managerFilePatterns: [
        "/(^|/)kubernetes/.+\\.ya?ml$/",
      ],
      matchStrings: [
        "(?<depName>[a-z0-9-]+)@(?<currentValue>[^@\\s]+)@https://grafana\\.com/api/plugins/(?<packageName>[a-z0-9-]+)/versions/[^/\\s]+/download",
      ],
      datasourceTemplate: "custom.grafana-plugins",
      versioningTemplate: "semver",
      // Rewrite both pins together; changing only one leaves the installer
      // version and the downloaded archive out of sync.
      autoReplaceStringTemplate: "{{{depName}}}@{{{newValue}}}@https://grafana.com/api/plugins/{{{packageName}}}/versions/{{{newValue}}}/download",
    },
    {
      customType: "regex",
      description: "Process CloudNativePG cluster images",
      managerFilePatterns: ["/(^|/)kubernetes/.+\\.ya?ml$/"],
      matchStrings: [
        "imageName:\\s*(?<depName>[^\\s:@]+):(?<currentValue>[^\\s@]+)(@(?<currentDigest>sha256:[a-f0-9]+))?",
      ],
      datasourceTemplate: "docker",
    },
    {
      customType: "regex",
      description: "Process OCI dependencies",
      managerFilePatterns: [
        "/\\.yaml$/",
      ],
      matchStrings: [
        "oci://(?<depName>[^:]+):(?<currentValue>\\S+)",
      ],
      datasourceTemplate: "docker",
    },
  ],
}
