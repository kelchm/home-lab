  {
    "refId": "D_nas_volumes",
    "key": "volumes",
    "source": "nas",
    "expr": "100 * (1 - max by (raidName) (raidFreeSize{job=\"synology-snmp\",raidName=~\"Volume.*\"}) / max by (raidName) (raidTotalSize{job=\"synology-snmp\",raidName=~\"Volume.*\"}))",
    "instant": true,
    "range": false,
    "scope": "nas",
    "capture": {
      "kind": "bounded",
      "key": "nas.volumes",
      "range": false
    }
  },
  {
    "refId": "D_nas_diskInfo",
