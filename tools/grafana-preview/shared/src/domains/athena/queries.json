  {
    "refId": "D_nas_assertion",
    "key": "assertion",
    "source": "nas",
    "expr": "max by(probe)(probe_success{job=\"pi-blackbox\"}) and on(probe) ((time()-max by(probe)(timestamp(probe_success{job=\"pi-blackbox\"}))) <= 180)",
    "instant": true,
    "range": false,
    "scope": "nas",
    "capture": {
      "kind": "catalog",
      "key": "H_P",
      "range": false
    }
  },
  {
    "refId": "D_nas_assertionHistory",
    "key": "assertionHistory",
    "source": "nas",
    "expr": "min by(probe)(min_over_time(probe_success{job=\"pi-blackbox\"}[$__interval])) and on(probe) ((time()-max by(probe)(timestamp(probe_success{job=\"pi-blackbox\"}))) <= 180)",
    "instant": false,
    "range": true,
    "scope": "nas",
    "capture": {
      "kind": "catalog",
      "key": "H_PH",
      "range": true
    }
  },
  {
    "refId": "D_nas_durationMs",
    "key": "durationMs",
