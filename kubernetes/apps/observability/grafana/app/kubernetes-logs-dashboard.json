{
  "uid": "kubernetes-logs",
  "title": "Kubernetes / Logs",
  "schemaVersion": 39,
  "description": "Container logs from the cluster. Opens on the last 15 minutes because log queries over long ranges are slow.",
  "tags": [
    "kubernetes",
    "logs"
  ],
  "timezone": "browser",
  "refresh": "30s",
  "editable": false,
  "graphTooltip": 1,
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "links": [
    {
      "title": "Observability / Pipeline",
      "url": "/d/observability-pipeline",
      "type": "link",
      "keepTime": true,
      "includeVars": false,
      "targetBlank": false
    }
  ],
  "templating": {
    "list": [
      {
        "name": "namespace",
        "label": "Namespace",
        "type": "query",
        "multi": true,
        "includeAll": true,
        "allValue": "*",
        "allowCustomValue": false,
        "current": {
          "text": [
            "observability"
          ],
          "value": [
            "observability"
          ]
        },
        "options": [],
        "datasource": {
          "type": "victoriametrics-logs-datasource",
          "uid": "victorialogs"
        },
        "refresh": 2,
        "sort": 1,
        "description": "Search values present in the selected time range (up to 1,000 suggestions).",
        "query": {
          "type": "fieldValue",
          "field": "k8s.namespace.name",
          "query": "k8s.namespace.name:*",
          "limit": 1000,
          "refId": "VictoriaLogsVariableQueryEditor-VariableQuery"
        }
      },
      {
        "name": "service",
        "label": "Service",
        "type": "query",
        "multi": true,
        "includeAll": true,
        "allValue": "*",
        "allowCustomValue": false,
        "current": {},
        "options": [],
        "datasource": {
          "type": "victoriametrics-logs-datasource",
          "uid": "victorialogs"
        },
        "refresh": 2,
        "sort": 1,
        "description": "Search values present in the selected time range (up to 1,000 suggestions).",
        "query": {
          "type": "fieldValue",
          "field": "service.name",
          "query": "k8s.namespace.name:in(${namespace})",
          "limit": 1000,
          "refId": "VictoriaLogsVariableQueryEditor-VariableQuery"
        }
      },
      {
        "name": "stream",
        "label": "Stream",
        "type": "custom",
        "multi": true,
        "includeAll": true,
        "allValue": "*",
        "allowCustomValue": false,
        "current": {},
        "options": [
          {
            "text": "stdout",
            "value": "stdout",
            "selected": false
          },
          {
            "text": "stderr",
            "value": "stderr",
            "selected": false
          }
        ],
        "query": "stdout,stderr"
      },
      {
        "name": "level",
        "label": "Severity",
        "type": "custom",
        "multi": true,
        "includeAll": true,
        "allValue": "*",
        "allowCustomValue": false,
        "current": {},
        "options": [
          {
            "text": "trace",
            "value": "trace",
            "selected": false
          },
          {
            "text": "debug",
            "value": "debug",
            "selected": false
          },
          {
            "text": "info",
            "value": "info",
            "selected": false
          },
          {
            "text": "warning",
            "value": "warning",
            "selected": false
          },
          {
            "text": "error",
            "value": "error",
            "selected": false
          },
          {
            "text": "critical",
            "value": "critical",
            "selected": false
          },
          {
            "text": "unknown",
            "value": "unknown",
            "selected": false
          }
        ],
        "query": "trace,debug,info,warning,error,critical,unknown"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "logs",
      "title": "Container logs",
      "description": "Choose a namespace, service and time range. Stream and severity start at All. Shows up to 1,000 matching lines; narrow the time range if needed. Open a row's log menu for details and surrounding logs.",
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "victorialogs"
      },
      "gridPos": {
        "h": 22,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "options": {
        "showTime": true,
        "showLabels": false,
        "wrapLogMessage": true,
        "sortOrder": "Descending"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "k8s.namespace.name:in(${namespace}) service.name:in(${service}) log.iostream:in(${stream})\n| format if (severity_number:range[1, 4]) \"trace\" as level\n| format if (severity_number:range[5, 8]) \"debug\" as level\n| format if (severity_number:range[9, 12]) \"info\" as level\n| format if (severity_number:range[13, 16]) \"warning\" as level\n| format if (severity_number:range[17, 20]) \"error\" as level\n| format if (severity_number:range[21, 24]) \"critical\" as level\n| format if (level:=\"\") \"unknown\" as level\n| filter level:in(${level})",
          "editorMode": "code",
          "queryType": "instant",
          "maxLines": 1000,
          "adHocFiltersMode": "off"
        }
      ]
    }
  ]
}
