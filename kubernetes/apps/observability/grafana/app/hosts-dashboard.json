{
  "uid": "hosts",
  "title": "Hosts",
  "description": "All enrolled Kubernetes, Proxmox and Spark machines, with collection status and comparable host signals.",
  "editable": false,
  "schemaVersion": 40,
  "version": 1,
  "refresh": "1m",
  "tags": [
    "overview",
    "hosts"
  ],
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timezone": "browser",
  "graphTooltip": 1,
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "refresh": 1
      },
      {
        "name": "platform",
        "label": "Platform",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "definition": "label_values(up{job=~\"node-exporter|(pve|spark)-node\",platform!=\"\"}, platform)",
        "query": {
          "query": "label_values(up{job=~\"node-exporter|(pve|spark)-node\",platform!=\"\"}, platform)",
          "refId": "platform"
        },
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "refresh": 2,
        "sort": 1,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "node",
        "label": "Node",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "definition": "label_values(up{job=~\"node-exporter|(pve|spark)-node\",platform!=\"\",platform=~\"$platform\"}, instance)",
        "query": {
          "query": "label_values(up{job=~\"node-exporter|(pve|spark)-node\",platform!=\"\",platform=~\"$platform\"}, instance)",
          "refId": "node"
        },
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "refresh": 2,
        "sort": 1,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "links": [
    {
      "title": "Node Exporter Full",
      "type": "link",
      "icon": "dashboard",
      "url": "/d/rYdddlPWk",
      "targetBlank": false,
      "keepTime": true
    }
  ],
  "panels": [
    {
      "id": 2,
      "type": "table",
      "title": "Machines",
      "description": "Current values per machine. Memory pressure is the share of time tasks stalled waiting for memory; a Spark with a model loaded keeps memory high without pressure. A machine stays listed for seven days after its last scrape.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 9
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          },
          "noValue": ""
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "CPU"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              },
              {
                "id": "decimals",
                "value": 1
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Memory"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              },
              {
                "id": "decimals",
                "value": 1
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Memory pressure"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              },
              {
                "id": "decimals",
                "value": 1
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 10
                    }
                  ]
                }
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Fullest filesystem"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              },
              {
                "id": "decimals",
                "value": 1
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 90
                    }
                  ]
                }
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "NVMe temperature"
            },
            "properties": [
              {
                "id": "unit",
                "value": "celsius"
              },
              {
                "id": "decimals",
                "value": 1
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 75
                    },
                    {
                      "color": "red",
                      "value": 80
                    }
                  ]
                }
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Last seen"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              },
              {
                "id": "decimals",
                "value": 0
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 600
                    }
                  ]
                }
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        },
        "sortBy": [
          {
            "displayName": "Machine",
            "desc": false
          }
        ]
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "time() - max by (instance, platform) (tlast_over_time(up{job=~\"node-exporter|(pve|spark)-node\",platform!=\"\",platform=~\"$platform\",instance=~\"$node\"}[7d]))",
          "refId": "A",
          "format": "table",
          "instant": true,
          "range": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "100 * sum by (instance) (avg by (instance, mode) (rate(node_cpu_seconds_total{job=~\"node-exporter|(pve|spark)-node\",platform!=\"\",platform=~\"$platform\",instance=~\"$node\",mode!~\"idle|iowait\"}[2m])))",
          "refId": "B",
          "format": "table",
          "instant": true,
          "range": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "100 * (1 - max by (instance) (node_memory_MemAvailable_bytes{job=~\"node-exporter|(pve|spark)-node\",platform!=\"\",platform=~\"$platform\",instance=~\"$node\"} / node_memory_MemTotal_bytes{job=~\"node-exporter|(pve|spark)-node\",platform!=\"\",platform=~\"$platform\",instance=~\"$node\"}))",
          "refId": "C",
          "format": "table",
          "instant": true,
          "range": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "100 * max by (instance) (rate(node_pressure_memory_stalled_seconds_total{job=~\"node-exporter|(pve|spark)-node\",platform!=\"\",platform=~\"$platform\",instance=~\"$node\"}[5m]))",
          "refId": "D",
          "format": "table",
          "instant": true,
          "range": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "100 * max by (instance) (1 - node_filesystem_avail_bytes{job=~\"node-exporter|(pve|spark)-node\",platform!=\"\",platform=~\"$platform\",instance=~\"$node\",fstype=~\"ext4|xfs|vfat\"} / (node_filesystem_size_bytes{job=~\"node-exporter|(pve|spark)-node\",platform!=\"\",platform=~\"$platform\",instance=~\"$node\",fstype=~\"ext4|xfs|vfat\"} > 0))",
          "refId": "E",
          "format": "table",
          "instant": true,
          "range": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "max by (instance) (node_hwmon_temp_celsius{job=~\"node-exporter|(pve|spark)-node\",platform!=\"\",platform=~\"$platform\",instance=~\"$node\",chip=~\"nvme.*\"} * on (instance, chip, sensor) group_left node_hwmon_sensor_label{job=~\"node-exporter|(pve|spark)-node\",platform!=\"\",platform=~\"$platform\",instance=~\"$node\",chip=~\"nvme.*\",label=\"Composite\"})",
          "refId": "F",
          "format": "table",
          "instant": true,
          "range": false
        }
      ],
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "instance",
            "mode": "outerTabular"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {
              "instance": 0,
              "platform": 1,
              "Value #B": 2,
              "Value #C": 3,
              "Value #D": 4,
              "Value #E": 5,
              "Value #F": 6,
              "Value #A": 7
            },
            "renameByName": {
              "instance": "Machine",
              "platform": "Platform",
              "Value #B": "CPU",
              "Value #C": "Memory",
              "Value #D": "Memory pressure",
              "Value #E": "Fullest filesystem",
              "Value #F": "NVMe temperature",
              "Value #A": "Last seen"
            }
          }
        }
      ]
    },
    {
      "id": 20,
      "type": "table",
      "title": "Collection",
      "description": "Latest scrape result for each collector. A blank cell means that collector does not report for that machine.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 24,
        "h": 9
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          },
          "noValue": ""
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "^(Node exporter|vmagent|Deployer|Proxmox API|GPU|Inference)$"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "1": {
                        "text": "up",
                        "color": "green",
                        "index": 0
                      },
                      "0": {
                        "text": "down",
                        "color": "red",
                        "index": 1
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        },
        "sortBy": [
          {
            "displayName": "Machine",
            "desc": false
          }
        ]
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "max by (instance, platform) (tlast_over_time(up{job=~\"node-exporter|(pve|spark)-node\",platform!=\"\",platform=~\"$platform\",instance=~\"$node\"}[7d]))",
          "refId": "A",
          "format": "table",
          "instant": true,
          "range": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "min by (instance) (up{job=~\"node-exporter|(pve|spark)-node\",platform!=\"\",platform=~\"$platform\",instance=~\"$node\"})",
          "refId": "B",
          "format": "table",
          "instant": true,
          "range": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "min by (instance) (up{job=~\"(pve|spark)-vmagent\",platform=~\"$platform\",instance=~\"$node\"})",
          "refId": "C",
          "format": "table",
          "instant": true,
          "range": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "min by (instance) (up{job=~\"(pve|spark)-deployer\",platform=~\"$platform\",instance=~\"$node\"})",
          "refId": "D",
          "format": "table",
          "instant": true,
          "range": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "min by (instance) (label_replace(up{job=\"pve-api\",cluster=\"pve-sbx\",platform=~\"$platform\",instance=~\"($node)[.].*\"}, \"instance\", \"$1\", \"instance\", \"([^.]+)[.].*\"))",
          "refId": "E",
          "format": "table",
          "instant": true,
          "range": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "min by (instance) (up{job=~\"spark-gpu\",platform=~\"$platform\",instance=~\"$node\"})",
          "refId": "F",
          "format": "table",
          "instant": true,
          "range": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "min by (instance) (up{job=~\"spark-inference\",platform=~\"$platform\",instance=~\"$node\"})",
          "refId": "G",
          "format": "table",
          "instant": true,
          "range": false
        }
      ],
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "instance",
            "mode": "outerTabular"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value #A": true
            },
            "indexByName": {
              "instance": 0,
              "platform": 1,
              "Value #B": 2,
              "Value #C": 3,
              "Value #D": 4,
              "Value #E": 5,
              "Value #F": 6,
              "Value #G": 7
            },
            "renameByName": {
              "instance": "Machine",
              "platform": "Platform",
              "Value #B": "Node exporter",
              "Value #C": "vmagent",
              "Value #D": "Deployer",
              "Value #E": "Proxmox API",
              "Value #F": "GPU",
              "Value #G": "Inference"
            }
          }
        }
      ]
    },
    {
      "id": 3,
      "type": "row",
      "title": "Trends",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "CPU used",
      "description": "CPU time outside idle and I/O wait, averaged across cores over two minutes.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 19,
        "w": 12,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "fillOpacity": 5,
            "lineWidth": 1,
            "showPoints": "never",
            "spanNulls": false
          },
          "min": 0,
          "max": 100
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "100 * sum by (instance) (avg by (instance, mode) (rate(node_cpu_seconds_total{job=~\"node-exporter|(pve|spark)-node\",platform!=\"\",platform=~\"$platform\",instance=~\"$node\",mode!~\"idle|iowait\"}[2m])))",
          "refId": "A",
          "legendFormat": "{{instance}}",
          "range": true
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Memory used",
      "description": "Memory in use after subtracting available memory; a loaded Spark model can keep this high.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 19,
        "w": 12,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "fillOpacity": 5,
            "lineWidth": 1,
            "showPoints": "never",
            "spanNulls": false
          },
          "min": 0,
          "max": 100
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "100 * (1 - max by (instance) (node_memory_MemAvailable_bytes{job=~\"node-exporter|(pve|spark)-node\",platform!=\"\",platform=~\"$platform\",instance=~\"$node\"} / node_memory_MemTotal_bytes{job=~\"node-exporter|(pve|spark)-node\",platform!=\"\",platform=~\"$platform\",instance=~\"$node\"}))",
          "refId": "A",
          "legendFormat": "{{instance}}",
          "range": true
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Fullest filesystem",
      "description": "Highest used percentage across local ext4, XFS and VFAT filesystems with non-zero capacity.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 26,
        "w": 12,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "fillOpacity": 5,
            "lineWidth": 1,
            "showPoints": "never",
            "spanNulls": false
          },
          "min": 0,
          "max": 100
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "100 * max by (instance) (1 - node_filesystem_avail_bytes{job=~\"node-exporter|(pve|spark)-node\",platform!=\"\",platform=~\"$platform\",instance=~\"$node\",fstype=~\"ext4|xfs|vfat\"} / (node_filesystem_size_bytes{job=~\"node-exporter|(pve|spark)-node\",platform!=\"\",platform=~\"$platform\",instance=~\"$node\",fstype=~\"ext4|xfs|vfat\"} > 0))",
          "refId": "A",
          "legendFormat": "{{instance}}",
          "range": true
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Network throughput",
      "description": "Combined receive and transmit throughput across physical wired NICs. VLAN subinterfaces and virtual devices are excluded.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 26,
        "w": 12,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bps",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "fillOpacity": 5,
            "lineWidth": 1,
            "showPoints": "never",
            "spanNulls": false
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "8 * sum by (instance) (rate(node_network_receive_bytes_total{job=~\"node-exporter|(pve|spark)-node\",platform!=\"\",platform=~\"$platform\",instance=~\"$node\",device=~\"(en|eth|nic|ib)[a-zA-Z0-9_]+\"}[5m]) + rate(node_network_transmit_bytes_total{job=~\"node-exporter|(pve|spark)-node\",platform!=\"\",platform=~\"$platform\",instance=~\"$node\",device=~\"(en|eth|nic|ib)[a-zA-Z0-9_]+\"}[5m]))",
          "refId": "A",
          "legendFormat": "{{instance}}",
          "range": true
        }
      ]
    }
  ]
}
