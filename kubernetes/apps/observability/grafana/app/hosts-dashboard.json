{
  "uid": "hosts",
  "title": "Hosts",
  "description": "PVE nodes and DGX Sparks. Type and Node come from each host's ingestion token.",
  "editable": false,
  "schemaVersion": 40,
  "version": 1,
  "refresh": "30s",
  "tags": [
    "hosts",
    "proxmox",
    "sparks"
  ],
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timezone": "browser",
  "graphTooltip": 1,
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "refresh": 1
      },
      {
        "name": "platform",
        "label": "Type",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "definition": "label_values(node_uname_info{job=~\"(pve|spark)-node\"}, platform)",
        "query": {
          "query": "label_values(node_uname_info{job=~\"(pve|spark)-node\"}, platform)",
          "refId": "platform"
        },
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "refresh": 2,
        "sort": 1,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "node",
        "label": "Node",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "definition": "label_values(node_uname_info{job=~\"(pve|spark)-node\",platform=~\"$platform\"}, instance)",
        "query": {
          "query": "label_values(node_uname_info{job=~\"(pve|spark)-node\",platform=~\"$platform\"}, instance)",
          "refId": "node"
        },
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "refresh": 2,
        "sort": 1,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "links": [
    {
      "title": "Node Exporter Full",
      "type": "link",
      "icon": "dashboard",
      "url": "/d/rYdddlPWk",
      "targetBlank": false
    }
  ],
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Nodes",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "table",
      "title": "Nodes",
      "description": "One row per physical node. Last sample is the age of the newest node metric; a node that stopped reporting stays listed for a day.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 24,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Last sample"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              },
              {
                "id": "decimals",
                "value": 0
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 60
                    },
                    {
                      "color": "red",
                      "value": 600
                    }
                  ]
                }
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "CPU used"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              },
              {
                "id": "decimals",
                "value": 1
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Memory available"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              },
              {
                "id": "decimals",
                "value": 1
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Root filesystem free"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              },
              {
                "id": "decimals",
                "value": 1
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "red",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 10
                    },
                    {
                      "color": "green",
                      "value": 20
                    }
                  ]
                }
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Hottest sensor"
            },
            "properties": [
              {
                "id": "unit",
                "value": "celsius"
              },
              {
                "id": "decimals",
                "value": 0
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 75
                    },
                    {
                      "color": "red",
                      "value": 90
                    }
                  ]
                }
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (instance, platform) (time() - tlast_over_time(node_uname_info{job=~\"(pve|spark)-node\",platform=~\"$platform\",instance=~\"$node\"}[1d]))",
          "format": "table",
          "instant": true,
          "range": false,
          "editorMode": "code"
        },
        {
          "refId": "B",
          "expr": "100 * (1 - avg by (instance, platform) (rate(node_cpu_seconds_total{job=~\"(pve|spark)-node\",platform=~\"$platform\",instance=~\"$node\",mode=\"idle\"}[5m])))",
          "format": "table",
          "instant": true,
          "range": false,
          "editorMode": "code"
        },
        {
          "refId": "C",
          "expr": "max by (instance, platform) (100 * node_memory_MemAvailable_bytes{job=~\"(pve|spark)-node\",platform=~\"$platform\",instance=~\"$node\"} / node_memory_MemTotal_bytes{job=~\"(pve|spark)-node\",platform=~\"$platform\",instance=~\"$node\"})",
          "format": "table",
          "instant": true,
          "range": false,
          "editorMode": "code"
        },
        {
          "refId": "D",
          "expr": "max by (instance, platform) (100 * node_filesystem_avail_bytes{job=~\"(pve|spark)-node\",platform=~\"$platform\",instance=~\"$node\",mountpoint=\"/\"} / node_filesystem_size_bytes{job=~\"(pve|spark)-node\",platform=~\"$platform\",instance=~\"$node\",mountpoint=\"/\"})",
          "format": "table",
          "instant": true,
          "range": false,
          "editorMode": "code"
        },
        {
          "refId": "E",
          "expr": "max by (instance, platform) (node_hwmon_temp_celsius{job=~\"(pve|spark)-node\",platform=~\"$platform\",instance=~\"$node\"})",
          "format": "table",
          "instant": true,
          "range": false,
          "editorMode": "code"
        },
        {
          "refId": "F",
          "expr": "max by (instance, platform, release) (node_uname_info{job=~\"(pve|spark)-node\",platform=~\"$platform\",instance=~\"$node\"})",
          "format": "table",
          "instant": true,
          "range": false,
          "editorMode": "code"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value #F": true
            },
            "indexByName": {
              "instance": 0,
              "platform": 1,
              "Value #A": 2,
              "Value #B": 3,
              "Value #C": 4,
              "Value #D": 5,
              "Value #E": 6,
              "release": 7
            },
            "renameByName": {
              "instance": "Node",
              "platform": "Type",
              "Value #A": "Last sample",
              "Value #B": "CPU used",
              "Value #C": "Memory available",
              "Value #D": "Root filesystem free",
              "Value #E": "Hottest sensor",
              "release": "Kernel"
            }
          }
        }
      ]
    },
    {
      "id": 3,
      "type": "row",
      "title": "Host",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "CPU used",
      "description": "Busy CPU time across all cores.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 10,
        "w": 12,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "fillOpacity": 5,
            "lineWidth": 1,
            "showPoints": "never",
            "spanNulls": false
          },
          "min": 0,
          "max": 100
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (1 - avg by (instance) (rate(node_cpu_seconds_total{job=~\"(pve|spark)-node\",platform=~\"$platform\",instance=~\"$node\",mode=\"idle\"}[5m])))",
          "legendFormat": "{{instance}}",
          "range": true,
          "editorMode": "code"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Memory available",
      "description": "On a Spark the GPU shares this memory, so a loaded model keeps it low by design; use pressure to judge trouble.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 10,
        "w": 12,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "fillOpacity": 5,
            "lineWidth": 1,
            "showPoints": "never",
            "spanNulls": false
          },
          "min": 0,
          "max": 100
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * node_memory_MemAvailable_bytes{job=~\"(pve|spark)-node\",platform=~\"$platform\",instance=~\"$node\"} / node_memory_MemTotal_bytes{job=~\"(pve|spark)-node\",platform=~\"$platform\",instance=~\"$node\"}",
          "legendFormat": "{{instance}}",
          "range": true,
          "editorMode": "code"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Memory pressure",
      "description": "Share of time every runnable task was stalled waiting for memory.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 17,
        "w": 12,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "fillOpacity": 5,
            "lineWidth": 1,
            "showPoints": "never",
            "spanNulls": false
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(node_pressure_memory_stalled_seconds_total{job=~\"(pve|spark)-node\",platform=~\"$platform\",instance=~\"$node\"}[5m])",
          "legendFormat": "{{instance}}",
          "range": true,
          "editorMode": "code"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Filesystem free",
      "description": "Local filesystems only.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 17,
        "w": 12,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "fillOpacity": 5,
            "lineWidth": 1,
            "showPoints": "never",
            "spanNulls": false
          },
          "min": 0,
          "max": 100
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * node_filesystem_avail_bytes{job=~\"(pve|spark)-node\",platform=~\"$platform\",instance=~\"$node\",fstype!~\"tmpfs|overlay|squashfs|ramfs|efivarfs|nfs.*|cifs|fuse.*\"} / node_filesystem_size_bytes{job=~\"(pve|spark)-node\",platform=~\"$platform\",instance=~\"$node\",fstype!~\"tmpfs|overlay|squashfs|ramfs|efivarfs|nfs.*|cifs|fuse.*\"}",
          "legendFormat": "{{instance}} {{mountpoint}}",
          "range": true,
          "editorMode": "code"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Network throughput",
      "description": "Receive is positive, transmit negative.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bps",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "fillOpacity": 5,
            "lineWidth": 1,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "8 * rate(node_network_receive_bytes_total{job=~\"(pve|spark)-node\",platform=~\"$platform\",instance=~\"$node\",device!~\"lo|veth.*|docker.*|br-.*|tap.*|fw.*|vmbr.*\"}[1m]) > 0",
          "legendFormat": "{{instance}} {{device}} rx",
          "range": true,
          "editorMode": "code"
        },
        {
          "refId": "B",
          "expr": "-8 * rate(node_network_transmit_bytes_total{job=~\"(pve|spark)-node\",platform=~\"$platform\",instance=~\"$node\",device!~\"lo|veth.*|docker.*|br-.*|tap.*|fw.*|vmbr.*\"}[1m]) < 0",
          "legendFormat": "{{instance}} {{device}} tx",
          "range": true,
          "editorMode": "code"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Link changes and errors",
      "description": "Carrier changes per 5 minutes and interface errors per second.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "fillOpacity": 5,
            "lineWidth": 1,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "increase(node_network_carrier_changes_total{job=~\"(pve|spark)-node\",platform=~\"$platform\",instance=~\"$node\",device!~\"lo|veth.*|docker.*|br-.*|tap.*|fw.*|vmbr.*\"}[5m]) > 0",
          "legendFormat": "{{instance}} {{device}} carrier changes",
          "range": true,
          "editorMode": "code"
        },
        {
          "refId": "B",
          "expr": "rate(node_network_receive_errs_total{job=~\"(pve|spark)-node\",platform=~\"$platform\",instance=~\"$node\",device!~\"lo|veth.*|docker.*|br-.*|tap.*|fw.*|vmbr.*\"}[5m]) + rate(node_network_transmit_errs_total{job=~\"(pve|spark)-node\",platform=~\"$platform\",instance=~\"$node\",device!~\"lo|veth.*|docker.*|br-.*|tap.*|fw.*|vmbr.*\"}[5m]) > 0",
          "legendFormat": "{{instance}} {{device}} errors/s",
          "range": true,
          "editorMode": "code"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Temperatures",
      "description": "Hardware sensors with their kernel label where one exists.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 31,
        "w": 24,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "fillOpacity": 5,
            "lineWidth": 1,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "node_hwmon_temp_celsius{job=~\"(pve|spark)-node\",platform=~\"$platform\",instance=~\"$node\"} * on (instance, chip, sensor) group_left (label) node_hwmon_sensor_label{job=~\"(pve|spark)-node\",platform=~\"$platform\",instance=~\"$node\"}",
          "legendFormat": "{{instance}} {{label}}",
          "range": true,
          "editorMode": "code"
        },
        {
          "refId": "B",
          "expr": "node_hwmon_temp_celsius{job=~\"(pve|spark)-node\",platform=~\"$platform\",instance=~\"$node\"} unless on (instance, chip, sensor) node_hwmon_sensor_label{job=~\"(pve|spark)-node\",platform=~\"$platform\",instance=~\"$node\"}",
          "legendFormat": "{{instance}} {{chip}} {{sensor}}",
          "range": true,
          "editorMode": "code"
        }
      ]
    },
    {
      "id": 11,
      "type": "row",
      "title": "GPU (Sparks)",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 38,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "GPU utilization",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 39,
        "w": 8,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "fillOpacity": 5,
            "lineWidth": 1,
            "showPoints": "never",
            "spanNulls": false
          },
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "nvidia_smi_utilization_gpu_ratio{job=\"spark-gpu\",platform=~\"$platform\",instance=~\"$node\"}",
          "legendFormat": "{{instance}}",
          "range": true,
          "editorMode": "code"
        }
      ]
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "GPU temperature",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 8,
        "y": 39,
        "w": 8,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "fillOpacity": 5,
            "lineWidth": 1,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "nvidia_smi_temperature_gpu{job=\"spark-gpu\",platform=~\"$platform\",instance=~\"$node\"}",
          "legendFormat": "{{instance}}",
          "range": true,
          "editorMode": "code"
        }
      ]
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "GPU power",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 16,
        "y": 39,
        "w": 8,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "watt",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "fillOpacity": 5,
