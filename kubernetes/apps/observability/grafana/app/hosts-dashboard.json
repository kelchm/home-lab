    {
      "id": 17,
      "type": "table",
      "title": "Guests",
      "description": "From the Proxmox API. Filtered by Node; shown when a PVE node is selected.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 53,
        "w": 14,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Running"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": {
                        "text": "stopped",
                        "color": "orange"
                      },
                      "1": {
                        "text": "running",
                        "color": "green"
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "CPU"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percentunit"
              },
              {
                "id": "decimals",
                "value": 1
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Memory"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percentunit"
              },
              {
                "id": "decimals",
                "value": 1
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (id) (pve_up{id=~\"(qemu|lxc)/.*\"}) * on (id) group_left (name, node) max by (id, name, node) (pve_guest_info{template=\"0\",node=~\"$node\"})",
          "format": "table",
          "instant": true,
          "range": false,
          "editorMode": "code"
        },
        {
          "refId": "B",
          "expr": "max by (id) (pve_cpu_usage_ratio{id=~\"(qemu|lxc)/.*\"}) * on (id) group_left (name, node) max by (id, name, node) (pve_guest_info{template=\"0\",node=~\"$node\"})",
          "format": "table",
          "instant": true,
          "range": false,
          "editorMode": "code"
        },
        {
          "refId": "C",
          "expr": "max by (id) (pve_memory_usage_bytes{id=~\"(qemu|lxc)/.*\"} / pve_memory_size_bytes{id=~\"(qemu|lxc)/.*\"}) * on (id) group_left (name, node) max by (id, name, node) (pve_guest_info{template=\"0\",node=~\"$node\"})",
          "format": "table",
          "instant": true,
          "range": false,
          "editorMode": "code"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {
              "name": 0,
              "id": 1,
              "node": 2,
              "Value #A": 3,
              "Value #B": 4,
              "Value #C": 5
            },
            "renameByName": {
              "name": "Guest",
              "id": "ID",
              "node": "Node",
              "Value #A": "Running",
              "Value #B": "CPU",
              "Value #C": "Memory"
            }
          }
        }
      ]
    },
