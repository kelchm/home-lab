{
  "uid": "external-hosts",
  "title": "External Hosts",
  "description": "Host-local collection and delivery for PVE and DGX Sparks. Missing data is unknown. Alerts are explicitly enrolled per host after live acceptance.",
  "editable": false,
  "schemaVersion": 40,
  "version": 1,
  "refresh": "15s",
  "tags": [
    "external",
    "proxmox",
    "spark"
  ],
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timezone": "browser",
  "graphTooltip": 1,
  "panels": [
    {
      "id": 1,
      "title": "Alert enrollment",
      "description": "Zero means this host is prepared but excluded from paging. Enrollment is a per-host Git activation after live acceptance.",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 1,
          "color": {
            "mode": "palette-classic"
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Not enrolled"
                },
                "1": {
                  "text": "Enrolled"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "orientation": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "external_host:expected{host=~\"$host\"}",
          "legendFormat": "{{host}}",
          "range": false,
          "instant": true,
          "editorMode": "code"
        }
      ]
    },
    {
      "id": 2,
      "title": "Current node scrape health",
      "description": "Healthy requires up=1 and an original scrape timestamp less than 90 seconds old. Replayed history does not imply current reachability.",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 1,
          "color": {
            "mode": "palette-classic"
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "No fresh scrape"
                },
                "1": {
                  "text": "Fresh scrape"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "orientation": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "external_host:node_fresh{host=~\"$host\"} or on(host, platform) (0 * external_host:expected{host=~\"$host\"})",
          "legendFormat": "{{host}}",
          "range": false,
          "instant": true,
          "editorMode": "code"
        }
      ]
    },
    {
      "id": 3,
      "title": "CPU used",
      "description": "Host CPU busy time; the Spark CPU and GPU share unified memory.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 12,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "color": {
            "mode": "palette-classic"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (1 - avg by(host) (rate(node_cpu_seconds_total{job=~\"spark-node|pve-node\",host=~\"$host\",mode=\"idle\"}[5m])))",
          "legendFormat": "{{host}}",
          "range": true,
          "instant": false,
          "editorMode": "code"
        }
      ]
    },
    {
      "id": 4,
      "title": "Available memory",
      "description": "Use host MemAvailable for GB10 unified memory. GPU framebuffer counters are N/A and GPU memory-utilization is not capacity.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 7,
        "w": 12,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "color": {
            "mode": "palette-classic"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * node_memory_MemAvailable_bytes{job=~\"spark-node|pve-node\",host=~\"$host\"} / node_memory_MemTotal_bytes{job=~\"spark-node|pve-node\",host=~\"$host\"}",
          "legendFormat": "{{host}}",
          "range": true,
          "instant": false,
          "editorMode": "code"
        }
      ]
    },
    {
      "id": 5,
      "title": "Memory pressure",
      "description": "Percentage of time at least one task waited for memory; compare with workload and available memory.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 12,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "color": {
            "mode": "palette-classic"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * rate(node_pressure_memory_waiting_seconds_total{job=~\"spark-node|pve-node\",host=~\"$host\"}[5m])",
          "legendFormat": "{{host}}",
          "range": true,
          "instant": false,
          "editorMode": "code"
        }
      ]
    },
    {
      "id": 6,
      "title": "Filesystem available",
      "description": "Host filesystems including the path holding the persistent queue. Inspect the actual mount and free space.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 14,
        "w": 12,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "color": {
            "mode": "palette-classic"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * node_filesystem_avail_bytes{job=~\"spark-node|pve-node\",host=~\"$host\",fstype!~\"tmpfs|overlay|squashfs\",mountpoint!~\"/run.*|/var/lib/docker.*\"} / node_filesystem_size_bytes{job=~\"spark-node|pve-node\",host=~\"$host\",fstype!~\"tmpfs|overlay|squashfs\",mountpoint!~\"/run.*|/var/lib/docker.*\"}",
          "legendFormat": "{{host}} {{mountpoint}}",
          "range": true,
          "instant": false,
          "editorMode": "code"
        }
      ]
    },
    {
      "id": 7,
      "title": "Network error rate",
      "description": "Endpoint interface errors. Spark 2 physical-link remediation remains issue #649.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 12,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "decimals": 1,
          "color": {
            "mode": "palette-classic"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(node_network_transmit_errs_total{job=~\"spark-node|pve-node\",host=~\"$host\",device!~\"lo|veth.*|docker.*|br-.*\"}[5m]) + rate(node_network_receive_errs_total{job=~\"spark-node|pve-node\",host=~\"$host\",device!~\"lo|veth.*|docker.*|br-.*\"}[5m])",
          "legendFormat": "{{host}} {{device}}",
          "range": true,
          "instant": false,
          "editorMode": "code"
        }
      ]
    },
    {
      "id": 8,
      "title": "Carrier changes",
      "description": "Carrier transitions over 15 minutes. Switch-side metrics and fabric topology are not supplied by these host counters.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 21,
        "w": 12,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 1,
          "color": {
            "mode": "palette-classic"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "increase(node_network_carrier_changes_total{job=~\"spark-node|pve-node\",host=~\"$host\",device!~\"lo|veth.*|docker.*|br-.*\"}[15m])",
          "legendFormat": "{{host}} {{device}}",
          "range": true,
          "instant": false,
          "editorMode": "code"
        }
      ]
    },
    {
      "id": 9,
      "title": "RDMA receive errors",
      "description": "Native endpoint RDMA port counters; missing means unsupported/absent, not a healthy switch fabric.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 12,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "decimals": 1,
          "color": {
            "mode": "palette-classic"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(node_infiniband_port_errors_received_total{job=~\"spark-node|pve-node\",host=~\"$host\"}[5m])",
          "legendFormat": "{{host}} {{device}} port {{port}}",
          "range": true,
          "instant": false,
          "editorMode": "code"
        }
      ]
    },
    {
      "id": 10,
      "title": "GPU utilization",
      "description": "GB10 GPU busy ratio. Compare under load during canary acceptance.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 28,
        "w": 12,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "color": {
            "mode": "palette-classic"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * nvidia_smi_utilization_gpu_ratio{job=\"spark-gpu\",host=~\"$host\"}",
          "legendFormat": "{{host}} {{uuid}}",
          "range": true,
          "instant": false,
          "editorMode": "code"
        }
      ]
    },
    {
      "id": 11,
      "title": "GPU temperature",
      "description": "Measured GPU temperature; thermal flags determine the throttling alert rather than an invented fixed temperature limit.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 35,
        "w": 12,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "decimals": 1,
          "color": {
            "mode": "palette-classic"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "nvidia_smi_temperature_gpu{job=\"spark-gpu\",host=~\"$host\"}",
          "legendFormat": "{{host}} {{uuid}}",
          "range": true,
          "instant": false,
          "editorMode": "code"
        }
      ]
    },
    {
      "id": 12,
      "title": "GPU board power",
      "description": "Native nvidia-smi power draw. Software power cap is common under normal workload.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 35,
        "w": 12,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "watt",
          "decimals": 1,
          "color": {
            "mode": "palette-classic"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "nvidia_smi_power_draw_watts{job=\"spark-gpu\",host=~\"$host\"}",
          "legendFormat": "{{host}} {{uuid}}",
          "range": true,
          "instant": false,
          "editorMode": "code"
        }
      ]
    },
    {
      "id": 13,
      "title": "GPU thermal slowdown",
      "description": "Hardware/software thermal reasons, 1 active and 0 inactive. The alert additionally requires a fresh successful GPU command.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 42,
        "w": 12,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 1,
          "color": {
            "mode": "palette-classic"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by(host, uuid) ({__name__=~\"nvidia_smi_clocks_event_reasons_(hw|sw)_thermal_slowdown\",job=\"spark-gpu\",host=~\"$host\"})",
          "legendFormat": "{{host}} {{uuid}}",
          "range": true,
          "instant": false,
          "editorMode": "code"
        }
      ]
    },
    {
      "id": 14,
      "title": "GPU command age",
      "description": "Age of the last successful bounded nvidia-smi command; cached exporter results are not current GPU state.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 42,
        "w": 12,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 1,
          "color": {
            "mode": "palette-classic"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "time() - nvidia_smi_last_collect_success_timestamp_seconds{job=\"spark-gpu\",host=~\"$host\"}",
          "legendFormat": "{{host}}",
          "range": true,
          "instant": false,
          "editorMode": "code"
        }
      ]
    },
    {
      "id": 15,
      "title": "Remote-write queue",
      "description": "Persistent and in-memory bytes waiting to send. Each host is capped at 1 GiB on disk; abrupt power loss can lose newest in-memory samples.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 49,
        "w": 12,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "decimals": 1,
          "color": {
            "mode": "palette-classic"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "vmagent_remotewrite_pending_data_bytes{job=~\"spark-collector|pve-vmagent\",host=~\"$host\"}",
          "legendFormat": "{{host}}",
          "range": true,
          "instant": false,
          "editorMode": "code"
        }
      ]
    },
    {
      "id": 16,
      "title": "Queue bytes discarded",
      "description": "Bytes discarded over 15 minutes, including cap overflow. Zero requires a present metric; No data is unknown.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 49,
        "w": 12,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "decimals": 1,
          "color": {
            "mode": "palette-classic"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "increase(vm_persistentqueue_bytes_dropped_total{job=~\"spark-collector|pve-vmagent\",host=~\"$host\"}[15m])",
          "legendFormat": "{{host}}",
          "range": true,
          "instant": false,
          "editorMode": "code"
        }
      ]
    },
    {
      "id": 17,
      "title": "Scrape configuration acceptance",
      "description": "Runtime reload and Spark publisher success. A rejected candidate can leave the last validated configuration running.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 56,
        "w": 12,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 1,
          "color": {
            "mode": "palette-classic"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
