{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "liveNow": false,
  "schemaVersion": 40,
  "timezone": "browser",
  "uid": "sparks-health",
  "title": "Sparks / GPU and host health",
  "description": "GPU and host health for the Spark machines. Shared CPU/GPU memory usage is host memory usage, not GPU allocation.",
  "editable": false,
  "version": 1,
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "tags": [
    "sparks",
    "hardware"
  ],
  "links": [
    {
      "title": "AI / Inference serving",
      "type": "link",
      "url": "/d/spark-tensorfold-performance",
      "keepTime": true,
      "includeVars": false,
      "targetBlank": false
    }
  ],
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "GPU utilisation",
      "description": "GPU busy fraction reported by the device.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "unit": "percentunit",
          "decimals": 1,
          "noValue": "Unavailable",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": [
            "last"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value_and_name",
        "wideLayout": true
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "nvidia_smi_utilization_gpu_ratio{job=\"spark-gpu\",platform=\"spark\",instance=~\"$node\"}",
          "legendFormat": "{{instance}}",
          "refId": "A",
          "range": false,
          "instant": true,
          "interval": "5s"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Memory used",
      "description": "Memory in use. CPU and GPU share one pool, so a loaded model keeps this high; the GPU exporter reports no separate GPU memory.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
