      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "1 - node_memory_MemAvailable_bytes{job=\"spark-node\",platform=\"spark\",instance=~\"$node\"} / node_memory_MemTotal_bytes{job=\"spark-node\",platform=\"spark\",instance=~\"$node\"}",
          "legendFormat": "{{instance}}",
          "refId": "A",
          "range": false,
          "instant": true,
          "interval": "15s"
        }
      ]
    },
