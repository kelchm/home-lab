        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "pikvm_hw_mem_percent{job=\"glkvm-kvmd\",instance=\"glkvm\"}",
          "legendFormat": "",
          "refId": "A",
          "range": false,
          "instant": true
        }
      ]
    },
