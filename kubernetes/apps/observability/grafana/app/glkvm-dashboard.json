  "liveNow": false,
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Metrics endpoint",
      "description": "Whether vmagent's last scrape of kvmd's export succeeded. GLKVMMetricsUnavailable fires after 10 minutes of failures and names the checks that tell a broken export from a down appliance.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "unit": "none",
          "noValue": "No scrape",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Failing",
                  "index": 0
                },
                "1": {
                  "text": "Answering",
                  "index": 1
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "text",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value",
        "wideLayout": false,
        "showPercentChange": false
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "up{job=\"glkvm-kvmd\",instance=\"glkvm\"}",
          "legendFormat": "",
          "refId": "A",
          "range": false,
          "instant": true
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "SoC temperature",
      "description": "The SoC's only thermal trip is critical, at 115 C, where the kernel shuts the appliance down. GLKVMHot fires above 95 C for 15 minutes.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 4,
        "y": 0,
        "w": 5,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "unit": "celsius",
          "noValue": "Unavailable",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              },
              {
                "color": "yellow",
                "value": 85
              },
              {
                "color": "orange",
                "value": 95
              },
              {
                "color": "red",
                "value": 105
              }
            ]
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value",
        "wideLayout": false,
        "showPercentChange": false
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "pikvm_hw_temp_cpu{job=\"glkvm-kvmd\",instance=\"glkvm\"}",
          "legendFormat": "",
          "refId": "A",
          "range": false,
          "instant": true
        }
      ]
    },
