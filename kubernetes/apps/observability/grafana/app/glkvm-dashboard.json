  "description": "The GL-RM1PE recovery console: whether its metrics endpoint answers, and its temperature, CPU, memory and network, from kvmd's own export.",
  "editable": false,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [
    {
      "title": "Hosts",
      "type": "link",
      "url": "/d/hosts",
      "keepTime": true,
      "includeVars": false,
      "targetBlank": false
