+def _identity(path):
+    st = path.stat()
+    return st.st_dev, st.st_ino, st.st_size, st.st_mtime_ns, st.st_ctime_ns
+
+
+def _sha256(path):
+    import hashlib
+    h = hashlib.sha256()
+    with open(path, "rb") as f:
+        while chunk := f.read(16 << 20):
+            h.update(chunk)
+    return h.hexdigest()
+
+
+def _existing_xet(hub, blob_name, sb):
+    """Reuse a cached ID for this SHA, including IDs from older chunkers."""
+    import re
+    for repo in sorted(hub.iterdir()):
+        if not repo.name.startswith(("models--", "datasets--")) or not repo.is_dir() or repo.is_symlink():
+            continue
+        link = repo / "blobs" / blob_name
+        if not link.is_symlink():
+            continue
+        try:
+            target = link.resolve(strict=True)
+            if re.fullmatch(r"[0-9a-f]{64}", target.name):
+                expected = sb.shared_blob_path(hub, target.name)
+                if target == expected.resolve() and target.is_file():
+                    return target.name
+        except (OSError, RuntimeError):
+            continue
+    return None
+
+
